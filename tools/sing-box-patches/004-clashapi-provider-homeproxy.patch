+// HomeProxyUpdateID reports the subscription key used by luci-app-homeproxy to
+// own its nodes: md5 of the subscription URL (the plugin's "grouphash"). The
+// Clash API hands a panel "update this airport" request over to the plugin's
+// update_provider.sh using this key, instead of only letting the kernel
+// re-download the provider (which would leave the plugin's own outbounds and
+// groups stale).
+func (s *ProviderRemote) HomeProxyUpdateID() string {
+	if s.url == "" {
+		return ""
+	}
+	sum := md5.Sum([]byte(s.url))
+	return hex.EncodeToString(sum[:])
+}
+
+// HomeProxyInitialPath exposes the seed file written by luci-app-homeproxy so the
+// Clash API can report the plugin's own "last updated" time (seed mtime) instead
+// of the kernel's fetch time. The kernel only sets lastUpdated when it actually
+// fetches; when it loads from initial_path the field stays at its zero value, so
+// a panel "update this airport" click (which updates the seed but relies on the
+// cache/seed at next start) would otherwise never move "updatedAt".
+func (s *ProviderRemote) HomeProxyInitialPath() string {
+	return s.initialPath
+}
