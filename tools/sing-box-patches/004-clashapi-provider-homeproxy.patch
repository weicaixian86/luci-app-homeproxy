+func getProviderProxyDelay(server *Server) func(w http.ResponseWriter, r *http.Request) {
+	delayHandler := getProxyDelay(server)
+	return func(w http.ResponseWriter, r *http.Request) {
+		tail := chi.URLParam(r, "*")
+		const suffix = "/healthcheck"
+		if !strings.HasSuffix(tail, suffix) {
+			render.Status(r, http.StatusNotFound)
+			render.JSON(w, r, ErrNotFound)
+			return
+		}
+		proxyName := strings.TrimPrefix(strings.TrimSuffix(tail, suffix), "/")
+		if decoded, err := url.PathUnescape(proxyName); err == nil {
+			proxyName = decoded
+		}
+		provider := r.Context().Value(CtxKeyProvider).(adapter.Provider)
+		/* Clients (zashboard and friends) address a provider proxy by the name
+		   they saw in /proxies, which is already prefixed with the provider tag
+		   ("AIR/n1"). Accept the bare node name too, so both spellings work. */
+		proxy, exist := provider.Outbound(proxyName)
+		if !exist {
+			proxy, exist = provider.Outbound(provider.Tag() + "/" + proxyName)
+		}
+		if !exist {
+			render.Status(r, http.StatusNotFound)
+			render.JSON(w, r, ErrNotFound)
+			return
+		}
+		ctx := context.WithValue(r.Context(), CtxKeyProxy, proxy)
+		delayHandler(w, r.WithContext(ctx))
+	}
+}
