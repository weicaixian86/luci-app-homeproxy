+func runHomeProxyProviderUpdate(updateID string) {
+	/* RUN_DIR of luci-app-homeproxy is /var/run/homeproxy; the script path is
+	   fixed by the package layout. Failures are silent on purpose: the panel
+	   already got its 204 and the plugin writes the real diagnostics to its own
+	   log (update_provider.sh logs both outcomes). */
+	err := os.WriteFile("/var/run/homeproxy/provider-update-id", []byte(updateID+"\n"), 0o600)
+	if err != nil {
+		return
+	}
+	cmd := exec.Command("/etc/homeproxy/scripts/update_provider.sh")
+	if err = cmd.Start(); err != nil {
+		return
+	}
+	_ = cmd.Process.Release()
+}
