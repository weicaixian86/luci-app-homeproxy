+func proxyDisplayName(tag string) string {
+	switch tag {
+	case "GLOBAL":
+		return "GLOBAL"
+	case "main-out":
+		return "主代理"
+	case "main-udp-out":
+		return "UDP 主代理"
+	case "direct-out":
+		return "直连"
+	case "block-out":
+		return "拦截"
+	default:
+		return tag
+	}
+}
+
+func lookupProxyByName(server *Server, name string) (adapter.Outbound, bool) {
+	proxy, exist := server.outbound.Outbound(name)
+	if exist {
+		return proxy, true
+	}
+
+	for _, detour := range server.outbound.Outbounds() {
+		if proxyDisplayName(detour.Tag()) == name {
+			return detour, true
+		}
+	}
+
+	for _, endpoint := range server.endpoint.Endpoints() {
+		if proxyDisplayName(endpoint.Tag()) == name {
+			return endpoint, true
+		}
+	}
+
+	return nil, false
+}
+
+func proxyDisplayNames(tags []string) []string {
+	return common.Map(tags, func(tag string) string {
+		return proxyDisplayName(tag)
+	})
+}
+
