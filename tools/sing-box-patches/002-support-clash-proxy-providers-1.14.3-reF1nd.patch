-func healthCheckProvider(w http.ResponseWriter, r *http.Request) {
-	provider := r.Context().Value(CtxKeyProvider).(adapter.Provider)
-	provider.HealthCheck(r.Context())
-	render.NoContent(w, r)
+// 面板的「测速」按钮（供应商卡片左上角那个闪电图标）打的就是这个端点：
+// zashboard 用 axios 发 GET /providers/proxies/<name>/healthcheck，超时 15s，
+// 回来之后立刻重新拉一次 /proxies 把延迟画到节点上。
+//
+// 原来的实现是「按顺序一个一个测、每个最多等 10 秒」：一个机场几十个节点，
+// 只要有几个连不通，整条请求就超过 15 秒被浏览器掐断 —— 用户看到的就是
+// 「按钮转圈、然后报错、节点延迟一片空白」，和没做一模一样。
+// 现在改成 8 路并发、单节点 6 秒、整批 12 秒封顶（都给 zashboard 的 15 秒
+// 留出余量）。单节点 3 秒是不够的：hysteria2 的 QUIC 握手 + TLS 冷启动实测
+// 要 4 秒以上（巴西-03 一次 4.26 s），被 3 秒砍掉的节点在面板上就是「没有延迟」。
+const (
+	providerHealthCheckConcurrency = 8
+	providerHealthCheckTimeout     = 6 * time.Second
+	providerHealthCheckBudget      = 12 * time.Second
+)
+
+func healthCheckProvider(server *Server) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		provider := r.Context().Value(CtxKeyProvider).(option.ClashProxyProviderOptions)
+		proxies := make([]adapter.Outbound, 0, len(provider.Proxies))
+		for _, proxyName := range provider.Proxies {
+			proxy, exist := lookupProxyByName(server, proxyName)
+			if !exist {
+				continue
+			}
+			proxies = append(proxies, proxy)
+		}
+
+		// 探测地址：Clash 原生 API 支持 ?url=，zashboard 的「测速」按钮不带参数。
+		// 不带时用 google 的 generate_204，和 client.js 里 urltest_url 的默认值
+		// 保持一致 —— 之前这里硬编码 gstatic，用户把 urltest_url 改成 google 之后
+		// 按钮测速仍然走 gstatic，两边口径对不上，还会让人以为改动没生效。
+		testURL := "https://www.google.com/generate_204"
+		if queryURL := r.URL.Query().Get("url"); queryURL != "" {
+			testURL = queryURL
+		}
+
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			var wg sync.WaitGroup
+			semaphore := make(chan struct{}, providerHealthCheckConcurrency)
+			for _, proxy := range proxies {
+				wg.Add(1)
+				go func(proxy adapter.Outbound) {
+					defer wg.Done()
+					semaphore <- struct{}{}
+					defer func() { <-semaphore }()
+					testProxyDelay(server, proxy, testURL)
+				}(proxy)
+			}
+			wg.Wait()
+		}()
+
+		select {
+		case <-done:
+		case <-time.After(providerHealthCheckBudget):
+		}
+		render.NoContent(w, r)
+	}
+}
+
+func testProxyDelay(server *Server, proxy adapter.Outbound, testURL string) {
+	ctx, cancel := context.WithTimeout(urltest.ContextWithUnifiedDelay(server.ctx, urltest.UnifiedDelayFromContext(server.ctx)), providerHealthCheckTimeout)
+	defer cancel()
+	delay, err := urltest.URLTest(ctx, testURL, proxy)
+	realTag := group.RealTag(server.outbound, proxy)
+	if err != nil {
+		server.urlTestHistory.DeleteURLTestHistory(realTag)
+	} else {
+		server.urlTestHistory.StoreURLTestHistory(realTag, &adapter.URLTestHistory{
+			Time:  time.Now(),
+			Delay: delay,
+		})
+	}
+	for _, detour := range server.outbound.Outbounds() {
+		urlTestGroup, isURLTestGroup := detour.(adapter.URLTestGroup)
+		if !isURLTestGroup {
+			continue
+		}
+		if !groupContains(server.outbound, urlTestGroup, realTag, map[string]bool{detour.Tag(): true}) {
+			continue
+		}
+		urlTestGroup.PerformUpdateCheck()
+	}
 }
 
