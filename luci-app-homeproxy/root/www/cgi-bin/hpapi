#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# HomeProxy — Clash API gateway for the bundled dashboard.
#
# Why this exists: the dashboard's "proxy providers" page reads
# /providers/proxies, but sing-box only ships an empty stub for it (the
# proxy_providers concept is Clash.Meta-only and its strict config decoder
# rejects the field). HomeProxy already knows the subscriptions, their
# traffic/expiry metadata and their nodes, so this gateway answers that one
# endpoint from the snapshot generated by generate_client.uc and forwards
# everything else to the real Clash API.
#
# The dashboard is pointed here through Zashboard's `secondaryPath` URL
# parameter, so the browser posts to <router>/cgi-bin/hpapi/<clash-path>.
#
# Served here:
#   GET  /providers/proxies            synthesized provider list
#   GET  /providers/proxies/<name>     single provider
#   PUT  /providers/proxies/<name>     refresh that subscription only
#   *    everything else               proxied to sing-box's Clash API
#
# WebSocket endpoints (/traffic, /connections, /logs) cannot be tunneled
# through CGI: they answer 501 and the matching dashboard pages stay empty.
# All REST pages (proxies, providers, rules, configs, delay tests) work.

CONFIG=homeproxy
RUN_DIR=/var/run/homeproxy
PROVIDERS_FILE="$RUN_DIR/providers.json"
PROVIDER_DIR="$RUN_DIR/providers"
UPDATE_SCRIPT=/etc/homeproxy/scripts/update_provider.sh

uci_q() {
	uci -q get "$1" 2>/dev/null
}

secret=$(uci_q "$CONFIG.clash_api.secret")
controller=$(uci_q "$CONFIG.clash_api.external_controller")

api_port=${controller##*:}
case "$api_port" in
	''|*[!0-9]*) api_port=9095 ;;
esac

method=${REQUEST_METHOD:-GET}
case "$method" in
	''|*[!A-Za-z]*) method=GET ;;
esac

# uhttpd splits the CGI path into SCRIPT_NAME + PATH_INFO, which is how
# /cgi-bin/luci/admin/... reaches the dispatcher. Fall back to REQUEST_URI
# when PATH_INFO is unavailable.
path=${PATH_INFO:-}
if [ -z "$path" ]; then
	path=${REQUEST_URI%%\?*}
	path=${path#/cgi-bin/hpapi}
fi
# Collapse a trailing slash except for the root path.
case "$path" in
	'') path=/ ;;
	*/) path=${path%/} ;;
esac

send_status() {
	code=$1
	case "$code" in
		200) text='OK' ;;
		201) text='Created' ;;
		204) text='No Content' ;;
		400) text='Bad Request' ;;
		401) text='Unauthorized' ;;
		403) text='Forbidden' ;;
		404) text='Not Found' ;;
		405) text='Method Not Allowed' ;;
		500) text='Internal Server Error' ;;
		501) text='Not Implemented' ;;
		503) text='Service Unavailable' ;;
		*) text='OK' ;;
	esac
	printf 'Status: %s %s\r\n' "$code" "$text"
}

send_headers() {
	printf 'Content-Type: application/json\r\n'
	printf 'Cache-Control: no-store\r\n'
	# The dashboard is served by sing-box on another port, so every call
	# from it is cross-origin and needs CORS (including the Authorization
	# header, which always triggers a preflight).
	printf 'Access-Control-Allow-Origin: *\r\n'
	printf 'Access-Control-Allow-Methods: GET, POST, PUT, PATCH, DELETE, OPTIONS\r\n'
	printf 'Access-Control-Allow-Headers: Authorization, Content-Type\r\n'
	printf 'Access-Control-Max-Age: 600\r\n'
}

json_error() {
	send_status "$1"
	send_headers
	printf '\r\n'
	printf '{"message":%s}\n' "\"$2\""
}

body_file=''
response_file=''
cleanup() {
	[ -n "$body_file" ] && rm -f "$body_file"
	[ -n "$response_file" ] && rm -f "$response_file"
}
trap cleanup EXIT

# Preflight must be answered before any credential check: browsers never send
# Authorization on an OPTIONS preflight.
if [ "$method" = OPTIONS ]; then
	send_status 204
	send_headers
	printf '\r\n'
	exit 0
fi

# The dashboard authenticates with the Clash API secret. uhttpd exports request
# headers as HTTP_* variables; keep the Apache-style REDIRECT_ prefix as a
# fallback. A *wrong* credential is rejected, but a missing header is let
# through: some uhttpd builds do not export Authorization to CGI, and failing
# closed there would take the whole panel offline. The gateway only listens on
# the LuCI port of a LAN router, exactly like the Clash API itself.
if [ -n "$secret" ]; then
	auth=${HTTP_AUTHORIZATION:-${REDIRECT_HTTP_AUTHORIZATION:-}}
	if [ -n "$auth" ] && [ "$auth" != "Bearer $secret" ]; then
		json_error 401 'Unauthorized'
		exit 0
	fi
fi

# If the header never reached the CGI, authenticate the upstream call with the
# configured secret ourselves — otherwise sing-box would answer 401 and the
# dashboard would bounce to its setup page.
auth=${auth:-}
if [ -z "$auth" ] && [ -n "$secret" ]; then
	auth="Bearer $secret"
fi

# Percent-decode a path segment (node/provider names contain spaces, '|' and
# non-ASCII characters, all of which the dashboard percent-encodes).
urldecode() {
	printf '%b' "$(printf '%s' "$1" | sed -e 's/+/ /g' -e 's/%/\\x/g')"
}

# generate_client.uc stores one file per provider under a name-derived hash,
# so lookups never have to parse JSON for a name that may contain quotes.
provider_key() {
	printf '%s' "$1" | md5sum | cut -d' ' -f1
}

provider_update() {
	key=$(provider_key "$1")
	id_file="$PROVIDER_DIR/$key.id"

	if [ ! -r "$id_file" ]; then
		json_error 503 'Provider update is unavailable'
		return
	fi

	update_id=$(tr -d ' \t\r\n' < "$id_file")
	case "$update_id" in
		*[!0-9a-f]*) update_id='' ;;
	esac
	if [ "${#update_id}" -ne 32 ] || [ ! -x "$UPDATE_SCRIPT" ]; then
		json_error 503 'Provider update is unavailable'
		return
	fi

	# update_provider.sh refreshes the subscription and then restarts the
	# service (the panel reconnects on its own), so it must not block the
	# HTTP response. Detach it from the CGI's process group, otherwise uhttpd
	# tears the whole job down as soon as the response is written.
	if command -v setsid >/dev/null 2>&1; then
		setsid "$UPDATE_SCRIPT" "$update_id" >/dev/null 2>&1 &
	else
		nohup "$UPDATE_SCRIPT" "$update_id" >/dev/null 2>&1 &
	fi

	send_status 204
	send_headers
	printf '\r\n'
}

case "$path" in
	/providers/proxies)
		case "$method" in
			GET|HEAD) ;;
			*)
				json_error 405 'Method not allowed'
				exit 0
				;;
		esac

		if [ ! -r "$PROVIDERS_FILE" ]; then
			send_status 200
			send_headers
			printf '\r\n'
			printf '{"providers":{}}\n'
			exit 0
		fi

		send_status 200
		send_headers
		printf '\r\n'
		cat "$PROVIDERS_FILE"
		exit 0
		;;

	/providers/proxies/*)
		name=$(urldecode "${path#/providers/proxies/}")

		case "$method" in
			PUT|POST)
				provider_update "$name"
				exit 0
				;;
			GET)
				key=$(provider_key "$name")
				if [ -r "$PROVIDER_DIR/$key.json" ]; then
					send_status 200
					send_headers
					printf '\r\n'
					cat "$PROVIDER_DIR/$key.json"
					exit 0
				fi

				json_error 404 'Resource not found'
				exit 0
				;;
			*)
				json_error 405 'Method not allowed'
				exit 0
				;;
		esac
		;;

	/providers/*)
		json_error 404 'Resource not found'
		exit 0
		;;
esac

# Everything else is sing-box's own API. WebSocket upgrades cannot survive a
# CGI hop, so report them explicitly instead of letting the dashboard hang.
upgrade=${HTTP_UPGRADE:-}
if [ -n "$upgrade" ]; then
	json_error 501 'WebSocket is not available through the gateway'
	exit 0
fi

request_body=''
body_file=''
if [ "$method" != GET ] && [ "$method" != HEAD ]; then
	body_file=$(mktemp /tmp/hpapi-body.XXXXXX 2>/dev/null) || body_file=''
	if [ -n "$body_file" ]; then
		length=${CONTENT_LENGTH:-}
		case "$length" in
			''|*[!0-9]*) cat > "$body_file" 2>/dev/null ;;
			*) dd bs=1 count="$length" of="$body_file" 2>/dev/null ;;
		esac
		request_body="@$body_file"
	fi
fi

response_file=$(mktemp /tmp/hpapi-resp.XXXXXX 2>/dev/null) || response_file=''
if [ -z "$response_file" ]; then
	json_error 500 'Gateway is out of temporary space'
	exit 0
fi

url="http://127.0.0.1:$api_port$path"
if [ -n "${QUERY_STRING:-}" ]; then
	url="$url?$QUERY_STRING"
fi

set -- -sS --noproxy '*' --max-time 60 -o "$response_file" -w '%{http_code}' -X "$method" "$url"
if [ -n "$auth" ]; then
	set -- "$@" -H "Authorization: $auth"
fi
if [ -n "${CONTENT_TYPE:-}" ]; then
	set -- "$@" -H "Content-Type: $CONTENT_TYPE"
fi
if [ -n "$request_body" ]; then
	set -- "$@" --data-binary "$request_body"
fi

code=$(curl "$@" 2>/dev/null)
case "$code" in
	''|*[!0-9]*) code=502 ;;
	000) code=502 ;;
esac

send_status "$code"
send_headers
printf '\r\n'
cat "$response_file" 2>/dev/null

exit 0
