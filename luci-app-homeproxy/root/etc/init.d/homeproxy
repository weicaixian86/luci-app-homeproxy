USE_PROCD=1

START=99
STOP=10

# 显式固定 PATH，而且必须放在本文件第一次调用 uci 之前（下面
# DNSMASQ_UCI_CONFIG 就在加载期调用）。本脚本会被 procd、install.sh、
# LuCI（ubus → rc.init）、cron 各自以不同环境启动；PATH 里缺 /sbin 时
# uci 会 command not found，而绝大多数调用都带 2>/dev/null，于是所有读取
# 都静默变成空值 / 默认值——「配置没生效」看起来和「用户没配」完全一样。
export PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

CONF="homeproxy"
PROG="/usr/bin/sing-box"
# Runtime reF1nd sing-box core downloader (architecture independent package).
CORE_SCRIPT="/etc/homeproxy/scripts/update_core.sh"

HP_DIR="/etc/homeproxy"
RUN_DIR="/var/run/homeproxy"
LOG_PATH="$RUN_DIR/homeproxy.log"

# we don't know which is the default server, just take the first one
DNSMASQ_UCI_CONFIG="$(uci -q show "dhcp.@dnsmasq[0]" | awk 'NR==1 {split($0, conf, /[.=]/); print conf[2]}')"
if [ -f "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG" ]; then
	DNSMASQ_DIR="$(awk -F '=' '/^conf-dir=/ {print $2}' "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG")/dnsmasq-homeproxy.d"
else
	DNSMASQ_DIR="/tmp/dnsmasq.d/dnsmasq-homeproxy.d"
fi

# ---------- clock / time-sync helpers ----------
# Only flag a genuinely implausible clock. A wrong date is what actually breaks
# HTTPS certificate validation (curl exit 60). We deliberately do NOT compare
# against the package file mtime here: a freshly installed package has an mtime
# equal to "now", which would otherwise mark every boot within the first few
# minutes as "unsynced" even when the clock is already correct. The timestamp
# carried by the log line is authoritative for humans.
clock_looks_unsynced() {
	local y
	y="$(date +%Y 2>/dev/null)" || return 1
	case "$y" in
		[0-9][0-9][0-9][0-9]) ;;
		*) return 1 ;;
	esac
	[ "$y" -lt 2024 ] || [ "$y" -gt 2035 ]
}

# Give NTP a brief chance to correct an implausible (boot-time) clock. Only
# waits when the clock actually looks wrong, so a normally-synced boot is
# unaffected; a ~12-second cap keeps service start from hanging on a network
# that simply has no reachable NTP server.
wait_for_time_sync() {
	clock_looks_unsynced || return 0
	# Best-effort one-shot NTP correction so a fresh boot with a wrong
	# (boot-time) clock can still validate TLS certificates for the core
	# download (otherwise curl exits 60). Run detached so the wait loop is not
	# blocked if no server is reachable. NOTE: BusyBox ntpd requires at least
	# one `-p PEER` (plain `ntpd -n -q` just prints usage), so servers must be
	# passed explicitly — preferring the UCI-configured ones.
	local srv s ntp_args=''
	srv="$(uci -q get system.ntp.server 2>/dev/null | tr '\n' ' ')"
	if command -v ntpd >/dev/null 2>&1; then
		if [ -n "$srv" ]; then
			# Build "-p <server>" without relying on `printf --`, which some
			# minimal BusyBox printf builds do not special-case; a plain loop
			# is unambiguously ash-safe (matches update_core.sh sync_time).
			for s in $srv; do
				ntp_args="$ntp_args -p $s"
			done
			# shellcheck disable=SC2086
			( ntpd -n -q $ntp_args 2>/dev/null ) &
		else
			( ntpd -n -q -p time1.aliyun.com -p pool.ntp.org 2>/dev/null ) &
		fi
	fi
	local i=0
	while [ "$i" -lt 12 ]; do
		sleep 1
		i=$((i + 1))
		clock_looks_unsynced || return 0
	done
	return 0
}

# ---------- core timezone (sing-box is Go) ----------
# sing-box formats its log timestamps with Go's local time, and Go understands
# exactly two forms of TZ: a TZif file path (optionally ':'-prefixed) or an IANA
# name such as "Asia/Shanghai". OpenWrt keeps a POSIX rule in /etc/TZ ("CST-8"),
# which Go does NOT parse — it silently falls back to UTC. That is why core log
# lines came out 8 hours behind every other source and out of order in the
# merged log view: TZ="CST-8" was a no-op. Resolve something Go can use, and
# leave a marker so the log view can still line the timestamps up if it cannot.
# Note that having a zonename in UCI proves nothing: images without tzdata still
# report "Asia/Shanghai" while /usr/share/zoneinfo is absent.
tz_local_offset() {
	local z sign digits hh mm
	z="$(date +%z 2>/dev/null)"
	# Some builds print "+08:00"; normalise to the POSIX "+0800" first.
	case "$z" in
		[+-][0-9][0-9]:[0-9][0-9]) z="${z%:*}${z#*:}" ;;
	esac
	case "$z" in
		[+-][0-9][0-9][0-9][0-9]) ;;
		*) return 1 ;;
	esac
	sign=1
	case "$z" in -*) sign=-1 ;; esac
	digits="${z#?}"
	hh="${digits%??}"
	mm="${digits#??}"
	hh="${hh#0}"
	mm="${mm#0}"
	[ -n "$hh" ] || hh=0
	[ -n "$mm" ] || mm=0
	printf '%s' $(( sign * (hh * 3600 + mm * 60) ))
}

# 32-bit big-endian value as four printf octal escapes. Kept as *text*: a shell
# variable cannot hold NUL bytes, so the escapes are expanded by printf later.
tz_be32() {
	printf '\\%03o\\%03o\\%03o\\%03o' \
		$(( ($1 >> 24) & 255 )) $(( ($1 >> 16) & 255 )) \
		$(( ($1 >> 8) & 255 )) $(( $1 & 255 ))
}

# Minimal TZif v1 with a single fixed offset (no transitions, no DST):
# 20-byte header + 6 counts + one ttinfo + "LOC" abbreviation = 54 bytes.
# Hand-rolled because the image ships no tzdata. Length and magic are verified
# afterwards, so a printf that refuses to expand escapes cannot leave a bogus
# file behind — the caller then falls back to UTC plus the shifted log view.
tz_write_fixed() {
	local out="$1" off="$2" u fmt i=0
	[ -n "$out" ] && [ -n "$off" ] || return 1
	mkdir -p "${out%/*}" 2>/dev/null
	u=$(( off & 4294967295 ))
	fmt='TZif\000'
	while [ "$i" -lt 15 ]; do
		fmt="$fmt\\000"
		i=$((i + 1))
	done
	# isutcnt, isstdcnt, leapcnt, timecnt, typecnt=1, charcnt=4
	fmt="$fmt$(tz_be32 0)$(tz_be32 0)$(tz_be32 0)$(tz_be32 0)$(tz_be32 1)$(tz_be32 4)"
	# gmtoff, isdst=0, abbrind=0, then the abbreviation block
	fmt="$fmt$(tz_be32 "$u")\\000\\000LOC\\000"
	printf "$fmt" > "$out" 2>/dev/null || return 1
	[ "$(wc -c < "$out" 2>/dev/null)" = 54 ] || return 1
	[ "$(head -c 4 "$out" 2>/dev/null)" = TZif ] || return 1
	return 0
}

# Sets CORE_TZ (the value exported to the core) and records what happened in
# $RUN_DIR/core_tz, which view/homeproxy/log.js reads: "local" when the core
# logs local time, "utc <seconds east of UTC>" when it cannot.
# A zone path is only usable when it really is a TZif file. /etc/localtime is
# usually a symlink into /tmp, and on images without tzdata it is left dangling
# or as a zero-byte placeholder; feeding that to the core makes Go fall back to
# UTC again — silently, while the marker below would still claim "local".
tz_is_tzif() {
	[ -f "$1" ] || return 1
	[ "$(head -c 4 "$1" 2>/dev/null)" = TZif ]
}

tz_setup_core() {
	local zn posix off offsign offabs offfmt
	CORE_TZ=""
	mkdir -p "$RUN_DIR" 2>/dev/null
	zn="$(uci -q get system.@system[0].zonename 2>/dev/null)"
	posix="$(cat /etc/TZ 2>/dev/null)"
	[ -n "$posix" ] || posix="$(uci -q get system.@system[0].timezone 2>/dev/null)"

	# 1) real tzdata on the image: a path keeps DST transitions working.
	if [ -n "$zn" ] && tz_is_tzif "/usr/share/zoneinfo/$zn"; then
		CORE_TZ=":/usr/share/zoneinfo/$zn"
	elif tz_is_tzif "/etc/localtime"; then
		CORE_TZ=":/etc/localtime"
	else
		# 2) no tzdata: synthesize a fixed-offset zone from the offset in
		#    effect right now. Wrong across a DST switch, right the rest of
		#    the year, and always better than UTC.
		off="$(tz_local_offset)" || off=""
		if [ -n "$off" ] && tz_write_fixed "$RUN_DIR/core.zone" "$off"; then
			CORE_TZ=":$RUN_DIR/core.zone"
			case "$posix" in
				*,*) log "提示：本机没有时区数据，已按当前偏移生成固定时区；夏令时切换后内核日志时间不会自动校正，重启服务即可。" ;;
			esac
		fi
		# No IANA-name fallback here on purpose: this core does not embed
		# time/tzdata (no such symbol in the binary), so a name would resolve
		# to nothing and Go would quietly use UTC — while the marker below
		# said "local" and the log view stopped shifting. Leave CORE_TZ empty
		# instead: Go treats that as UTC, exactly what the marker claims.
	fi

	if [ -n "$CORE_TZ" ]; then
		printf '%s' "local" > "$RUN_DIR/core_tz" 2>/dev/null
	else
		off="$(tz_local_offset)"
		[ -n "$off" ] || off=0
		offsign="+"
		[ "$off" -lt 0 ] && offsign="-"
		offabs=${off#-}
		offfmt="$(printf '%s%02d:%02d' "$offsign" $((offabs / 3600)) $(((offabs % 3600) / 60)))"
		printf 'utc %s' "$off" > "$RUN_DIR/core_tz" 2>/dev/null
		log "提示：本机没有可用的时区数据（/usr/share/zoneinfo 缺失，或 /etc/localtime 不存在／不是时区文件），sing-box 只能按 UTC 记日志；「运行日志」页已按本地时区（$offfmt）换算显示。"
	fi
}

log() {
	local ts marker=""
	ts="$(date "+%Y-%m-%d %H:%M:%S")"
	clock_looks_unsynced && marker="（时间未同步）"
	echo -e "$ts [DAEMON] ${marker}$*" >> "$LOG_PATH"
}

# Panel download log: mirror the RPC panelLog() format so the "Logs" page
# shows one consistent timeline for both the UI-triggered and the
# boot-time (service-start) panel downloads.
	panel_log() {
		mkdir -p "$RUN_DIR" 2>/dev/null
		local msg="面板: $*"
		printf '%s %s\n' "$(date "+%Y-%m-%d %H:%M:%S")" "$msg" >> "$RUN_DIR/panel_download.log" 2>/dev/null
		logger -t homeproxy "$msg" 2>/dev/null
	}

	# sing-box / ucode emit ANSI color escapes ([31m ... [0m) on failures; the
	# plain-text log (and the LuCI log viewer) should not show raw escape codes.
	# Run a command and append its stderr to the main log with colors stripped.
	append_err_stripped() {
		"$@" 2> "$RUN_DIR/.stderr.tmp"
		local rc=$?
		if [ -s "$RUN_DIR/.stderr.tmp" ]; then
			# busybox sed has no \xHH; embed a literal ESC via printf.
			sed "s/$(printf '\033')\[[0-9;]*m//g" "$RUN_DIR/.stderr.tmp" >> "$LOG_PATH"
		fi
		rm -f "$RUN_DIR/.stderr.tmp"
		return $rc
	}

	# 判断系统是否已存在 sing-box 专用用户/组。iStoreOS 等 busybox 环境通常
	# 不存在该账户，此时内核以 root 运行（不进 ujail）。仅当官方 OpenWrt 上
	# 确实存在该用户时，下方 ujail 分支才会自动降权——本函数只做判断、不创建。
	have_sing_box_user() {
		grep -qs '^sing-box:' /etc/passwd && grep -qs '^sing-box:' /etc/group
	}

	# 历史上曾在此主动创建 sing-box 专用用户并走 ujail 沙箱，但 iStoreOS 的
	# busybox 不带 adduser/addgroup，创建必然失败。现已改为默认以 root 运行，
	# 不再主动创建用户。若系统已存在 sing-box 用户，下方 ujail 分支
	# （have_sing_box_user 判断）仍会自动降权，无需在此预创建。

# Auto-install the dashboard panel on service start, exactly like the kernel
# is fetched by update_core.sh ensure: only when it is missing, and only in the
# routing modes that actually use the panel. The sing-box core must be running
# first (the clash API serves /upgrade/ui), so we poll for readiness, then let
# the core download and extract the dashboard itself.
ensure_panel() {
	local routing_mode controller port secret panel_dir base_url tmp ok

	routing_mode="$(uci -q get "$CONF.config.routing_mode" 2>/dev/null)"
	if [ "$routing_mode" != "custom" ] && [ "$routing_mode" != "bypass_mainland_china" ]; then
		# Previously a silent `return 0` with no log — when routing_mode was
		# unexpectedly empty or wrong, the panel simply never downloaded and
		# there was zero trace of why. Log it so the panel log is never silent.
		panel_log "面板自动下载跳过：routing_mode='${routing_mode:-空}'（仅 custom / bypass_mainland_china 模式需要面板）。"
		return 0
	fi

	controller="$(uci -q get "$CONF.clash_api.external_controller" 2>/dev/null)"
	port="${controller##*:}"
	[ -n "$port" ] || port="9090"
	secret="$(uci -q get "$CONF.clash_api.secret" 2>/dev/null)"
	panel_dir="$(uci -q get "$CONF.clash_api.external_ui" 2>/dev/null)"
	[ -n "$panel_dir" ] || panel_dir="$HP_DIR/run/ui"

	if [ -f "$panel_dir/index.html" ]; then
		panel_log "面板已存在，跳过自动下载。"
		return 0
	fi

	# Download the dashboard ourselves FIRST, through a mirror chain, and only
	# fall back to the core's /upgrade/ui when that fails.
	#
	# The core endpoint is single-source (one detour, no fallback), silent and
	# synchronous, and — worst of all — only exists once the Clash API is
	# listening, which happens after every remote rule-set has been
	# initialised. That coupling is why a slow rule-set warm-up used to leave
	# the panel undownloaded for no reason at all. fetch_panel.sh needs neither
	# the core nor the API: it downloads, validates the zip magic, unpacks and
	# installs into external_ui, which the core serves statically.
	if [ -x "$HP_DIR/scripts/fetch_panel.sh" ]; then
		if /bin/sh "$HP_DIR/scripts/fetch_panel.sh" --budget 900; then
			if [ -f "$panel_dir/index.html" ]; then
				panel_log "下载成功（本地预下载，未依赖 clash API）"
				return 0
			fi
		fi
		panel_log "本地预下载未成功，改由核心的 /upgrade/ui 下载（需等待内核就绪）。"
	fi

	base_url="http://127.0.0.1:${port}"
	tmp="/tmp/homeproxy_panel_upgrade.res"

	# Wait for the core's clash API to come up (procd launches it asynchronously).
	#
	# 300 tries (~10 min), not 30/90: on startup the core initialises its
	# rule-sets BEFORE it starts the clash API listener, and on a slow line that
	# phrase alone ("initialize rule-set take too much time to finish!") can run
	# for many minutes. 30 tries (~60 s) and then 90 tries (~3 min) both expired
	# before the socket existed, the panel was never downloaded, and the log only
	# said "API not ready" — even though `ps` showed the core happily starting.
	# A refused connection fails instantly, so a long loop is free when the core
	# is really down; it only costs wall-clock time when the core is coming up.
	# A progress line is written every minute so the log never looks frozen.
	# The readiness probe MUST carry the same Authorization header as the real
	# request. sing-box installs `authentication(secret)` as a global router
	# middleware (experimental/clashapi/server.go), so /version is gated too:
	# with a secret configured, an unauthenticated probe gets 401 on every try,
	# the loop exhausts and the panel is simply never downloaded — while the log
	# misleadingly says the API "never became ready".
	# Clash API 调用统一走这两个包装：curl 是包的硬依赖（Makefile 的
	# LUCI_DEPENDS 里有 +curl），wget 只是精简镜像里可能存在的替代品。
	# 原来这里把 wget 写死，镜像里没有 wget 时「就绪探测 + /upgrade/ui」
	# 全部静默失败，日志只会显示「clash API 未就绪」，看不出是缺下载器。
	api_get() {		# api_get <url> <timeout>
		if command -v curl >/dev/null 2>&1; then
			if [ -n "$secret" ]; then
				curl -fsS --connect-timeout 5 --max-time "$2" \
					-H "Authorization: Bearer ${secret}" "$1" 2>/dev/null
			else
				curl -fsS --connect-timeout 5 --max-time "$2" "$1" 2>/dev/null
			fi
		elif [ -n "$secret" ]; then
			wget -qO- -T "$2" --header "Authorization: Bearer ${secret}" "$1" 2>/dev/null
		else
			wget -qO- -T "$2" "$1" 2>/dev/null
		fi
	}

	api_post() {		# api_post <url> <timeout>（/upgrade/ui 只认 POST 空数据）
		# 这里刻意不加 -f：失败时内核返回 {"error":"..."} 的 JSON，正是下面
		# 用来给用户看具体原因的来源；-f 会把响应体丢掉，只剩一句笼统失败。
		if command -v curl >/dev/null 2>&1; then
			if [ -n "$secret" ]; then
				curl -sS --connect-timeout 5 --max-time "$2" -X POST --data '' \
					-H "Authorization: Bearer ${secret}" "$1" 2>/dev/null
			else
				curl -sS --connect-timeout 5 --max-time "$2" -X POST --data '' "$1" 2>/dev/null
			fi
		elif [ -n "$secret" ]; then
			wget -qO- -T "$2" --post-data='' --header "Authorization: Bearer ${secret}" "$1" 2>/dev/null
		else
			wget -qO- -T "$2" --post-data='' "$1" 2>/dev/null
		fi
	}

	probe_version() {
		api_get "${base_url}/version" 3 >/dev/null 2>&1
	}

	local i ready=0
	for i in $(seq 1 300); do
		if probe_version; then
			ready=1
			break
		fi
		# Every 30 tries (about one minute) leave a trace, so that a long
		# rule-set warm-up does not look like a dead panel download.
		if [ $((i % 30)) -eq 0 ]; then
			panel_log "等待 clash API 就绪（端口 ${port}，已等 $((i * 2)) 秒）…"
		fi
		sleep 2
	done

	if [ "$ready" != "1" ]; then
		panel_log "下载失败：等待 clash API 就绪超时（端口 ${port}，已等待约 10 分钟），请稍后从页面手动更新面板。"
		# A wrong secret is indistinguishable from a down API at this point
		# (both make the probe fail), so call it out explicitly.
		if [ -n "$secret" ]; then
			panel_log "提示：已配置 API 密钥，就绪探测需携带该密钥；若密钥填写有误也会导致本超时。可临时清空 clash_api.secret 对比验证。"
		fi
		return 1
	fi

	panel_log "开始下载（服务启动自动触发）"
	# /upgrade/ui is SYNCHRONOUS: the core downloads the whole archive before it
	# answers, and sends no data at all in the meantime. The zashboard archive is
	# ~9.5 MB, so the budget must cover the *slowest* mirror we ship, not the
	# fastest — gh-proxy.com measured between 17 and 132 KB/s on the target
	# router, i.e. 570 s at the low end. A shorter -T reports a bogus failure on
	# a download that is actually progressing. -T is a socket inactivity
	# timeout, not a total budget, so raising it only makes a stalled transfer
	# take longer to give up.
	api_post "${base_url}/upgrade/ui" 1200 >"$tmp" 2>/dev/null && ok=1

	if [ "$ok" = "1" ] && grep -q '"status"[[:space:]]*:[[:space:]]*"ok"' "$tmp"; then
		panel_log "下载成功"
		rm -f "$tmp"
		return 0
	fi

	# The core answers {"error":"..."} on failure — e.g. it could not fetch the
	# dashboard archive through the configured mirror, or `external_ui` is not
	# enabled. Surface that reason instead of a generic message: without it the
	# cause is invisible from LuCI and the user has to SSH in and read the
	# core log, which is exactly how the earlier "unknown error" reports read.
	local detail
	detail="$(tr -d '\r\n' < "$tmp" 2>/dev/null \
		| sed -n 's/.*"error"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
	if [ -z "$detail" ]; then
		detail="$(tr -d '\r\n' < "$tmp" 2>/dev/null | cut -c1-160)"
	fi
	[ -n "$detail" ] || detail="clash API 未返回成功状态（响应为空，通常是下载镜像超时）"
	panel_log "下载失败：${detail}"
	panel_log "提示：可在「面板」设置里换一个更快的下载镜像；也可手动下载面板 zip 解压到 ${panel_dir}。"
	rm -f "$tmp"
	return 1
}

# 提前下载面板：与 ensure_panel 不同，本函数只走「本地多镜像预下载」
# （fetch_panel.sh），不等待 Clash API，因此不需要内核运行。它被 start_service
# 在「无节点/服务端未启用」提前返回之前调用，避免半配置路由器永远下不到面板。
# 末尾的 ensure_panel（含 Clash API 兜底）仍会执行，但通常此时面板已就位而跳过。
prefetch_panel() {
	local routing_mode panel_dir

	routing_mode="$(uci -q get "$CONF.config.routing_mode" 2>/dev/null)"
	case "$routing_mode" in
		custom|bypass_mainland_china) ;;
		*)
			# 非面板模式不需要面板，但留一条记录便于排查。
			panel_log "面板自动下载跳过：routing_mode='${routing_mode:-空}'（仅 custom / bypass_mainland_china 模式需要面板）。"
			return 0
			;;
	esac

	panel_dir="$(uci -q get "$CONF.clash_api.external_ui" 2>/dev/null)"
	[ -n "$panel_dir" ] || panel_dir="$HP_DIR/run/ui"
	[ -f "$panel_dir/index.html" ] && return 0

	if [ -x "$HP_DIR/scripts/fetch_panel.sh" ]; then
		if /bin/sh "$HP_DIR/scripts/fetch_panel.sh" --budget 900; then
			if [ -f "$panel_dir/index.html" ]; then
				panel_log "面板已提前下载（本地预下载，不依赖服务启动）。"
			fi
		else
			panel_log "面板提前下载未成功（服务启动后会再尝试）。"
		fi
	fi
}

init_logs() {
	mkdir -p "$RUN_DIR"
	mkdir -p "$HP_DIR/run/ui"
	touch "$LOG_PATH" "$RUN_DIR/sing-box-c.log" "$RUN_DIR/sing-box-s.log" \
	      "$RUN_DIR/core_download.log" "$RUN_DIR/panel_download.log"
	chown -R sing-box:sing-box "$RUN_DIR" 2>"/dev/null"
	chown -R sing-box:sing-box "$HP_DIR/run" 2>"/dev/null"
}

valid_update_cron() {
	echo "$1" | grep -Eq '^([0-9]|[0-5][0-9]) ([0-9]|[01][0-9]|2[0-3]) \* \* ([0-7]|\*)$'
}

has_ruleset_cron() {
	printf '%s\n' "$ruleset_cron_list" | grep -Fxq -- "$1"
}

add_ruleset_cron() {
	local section="$1"
	local enabled auto_update type update_time

	config_get_bool enabled "$section" "enabled" "0"
	config_get_bool auto_update "$section" "auto_update" "1"
	# 默认 remote：与内核（sing-box 的 rule_set.type 默认 remote）、rpcd
	# （sec.type || 'remote'）以及 fetch_rulesets.sh 的 list_sections 一致。
	# 这里曾默认 local，导致「没写 type」的规则集既不会下载也拿不到定时任务。
	config_get type "$section" "type" "remote"
	config_get update_time "$section" "update_interval" ""

	[ "$enabled" = "1" ] || return
	[ "$auto_update" = "1" ] || return
	[ "$type" = "remote" ] || return
	[ -n "$update_time" ] || return
	valid_update_cron "$update_time" || return
	has_ruleset_cron "$update_time" && return

	echo -e "$update_time sh $HP_DIR/scripts/update_rulesets.sh #${CONF}_autosetup" >> "/etc/crontabs/root"
	ruleset_cron_list="${ruleset_cron_list}
${update_time}"
	cron_reload="1"
}

setup_auto_update_cron() {
	local cron_reload="0"
	mkdir -p "/etc/crontabs"
	touch "/etc/crontabs/root"
	grep -q "#${CONF}_autosetup" "/etc/crontabs/root" 2>"/dev/null" && cron_reload="1"
	sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>"/dev/null"

	local auto_update auto_update_time
	config_get_bool auto_update "subscription" "auto_update" "0"
	if [ "$auto_update" = "1" ]; then
		config_get auto_update_time "subscription" "auto_update_time" "0 0 * * *"
		if valid_update_cron "$auto_update_time"; then
			echo -e "$auto_update_time sh $HP_DIR/scripts/update_crond.sh #${CONF}_autosetup" >> "/etc/crontabs/root"
			cron_reload="1"
		fi
	fi

	local ruleset_cron_list=""
	config_foreach add_ruleset_cron "ruleset"
	[ "$cron_reload" = "1" ] && /etc/init.d/cron restart
}

# Refresh the local rule-set cache BEFORE the config is generated.
#
# generate_client.uc emits `type: local` whenever a validated copy exists;
# otherwise the rule-set stays `remote` and sing-box downloads it while
# initialising — that is, BEFORE the Clash API listener comes up. With 20+
# enabled rule-sets on a slow mirror that pushed the API past every readiness
# window, so the panel was never downloaded at all.
#
# Called from start_service(), which reload_service() also goes through
# (reload = stop + start). That is what makes LuCI's "Save & Apply" check and
# fill the cache by itself: valid local copies are skipped, missing or invalid
# ones are downloaded. Every branch writes to the main log — a silent skip used
# to look exactly like "nothing happened".
sync_rulesets() {
	local ruleset_script="$HP_DIR/scripts/fetch_rulesets.sh"

	# 以前这里直接 `[ -f ... ] || return 0`：脚本一旦缺失就静默退出，主日志
	# 里连一行「规则集」都不会出现，用户看到的现象与「保存并应用根本没触发
	# 规则集同步」完全无法区分。现在每一层都必须留痕。
	if [ ! -f "$ruleset_script" ]; then
		log "规则集检查：下载脚本 $ruleset_script 缺失，跳过预下载（内核将退化为按 remote 自行下载，首启动会很慢）。"
		return 0
	fi

	# --check 的完整输出：最后一行是 sections=/total=/missing= 统计，
	# 之前的 skip 行逐条说明「这一段为什么没被纳入下载」。旧版脚本只打
	# total=/missing=，这里的解析对两种格式都成立。
	local report_full report sections total missing sec_count
	report_full="$(/bin/sh "$ruleset_script" --check 2>/dev/null)"
	report="$(printf '%s\n' "$report_full" | tail -n 1)"
	sections="$(printf '%s\n' "$report" | sed -n 's/.*sections=\([0-9]*\).*/\1/p')"
	total="$(printf '%s\n' "$report" | sed -n 's/.*total=\([0-9]*\).*/\1/p')"
	missing="$(printf '%s\n' "$report" | sed -n 's/.*missing=\([0-9]*\).*/\1/p')"
	case "$sections" in ''|*[!0-9]*) sections="" ;; esac
	case "$total" in ''|*[!0-9]*) total="" ;; esac
	case "$missing" in ''|*[!0-9]*) missing="" ;; esac

	if [ -z "$total" ] || [ -z "$missing" ]; then
		log "规则集检查：未能获取规则集状态（$ruleset_script --check 输出「${report}」），跳过。"
		return 0
	fi

	# 把逐条排除原因转进主日志。
	# 「界面显示已启用、UCI 里其实没有 enabled=1」「类型是 local」这类问题
	# 以前完全没有痕迹，用户只能反复猜，这里必须留证。
	# 分两轮：warn（异常证据）先全部输出且不限行数——它永远排在 skip 之后、
	# 统计行之前，若和 skip 一起 head 掉，规则集一多就会被截掉，而它恰恰是
	# 唯一能指出「扫描本身失败」的那一行。
	local rs_line
	printf '%s\n' "$report_full" | while IFS= read -r rs_line; do
		case "$rs_line" in
			"warn section_scan_failed"*)
				log "规则集检查：【异常】UCI 里存在 ruleset 段，但扫描不到段名（解析失败），请连同本日志反馈。" ;;
			"warn uci_missing source=file"*)
				log "规则集检查：【异常】uci 命令不可用（运行环境 PATH 不完整），本次结论来自直接解析 /etc/config/$CONF。" ;;
			"warn uci_missing source=none"*)
				log "规则集检查：【异常】uci 命令不可用，且 /etc/config/$CONF 也读不到，无法区分「没有规则集」与「读取失败」。" ;;
			warn\ *)
				log "规则集检查：${rs_line#warn }" ;;
		esac
	done
	printf '%s\n' "$report_full" \
		| grep '^skip ' \
		| head -n 10 \
		| while IFS= read -r rs_line; do
			log "规则集检查：未纳入下载 ${rs_line#skip }"
		done

	sec_count="${sections:-$(uci -q show "$CONF" 2>/dev/null | grep -c "=ruleset")}"

	if [ "$total" = "0" ]; then
		log "规则集检查：当前没有已启用的远程规则集，跳过。"
		if [ "${sec_count:-0}" -gt 0 ]; then
			log "提示：配置里共有 ${sec_count} 个 ruleset 段，但没有一条满足「启用 + 远程」。请到规则集页面确认每条的「启用」开关与「类型」（类型为本地的规则集不会下载）。"
		else
			log "提示：配置里没有任何 ruleset 段。规则集需要在「规则集」页手动添加（如 geosite-cn），插件不预置；添加后点「保存并应用」即会下载。"
		fi
		return 0
	fi

	if [ "$missing" = "0" ]; then
		log "规则集检查：共 ${total} 条远程规则集，本地均已有有效副本，跳过下载（要强制重下请用规则集页面的「立即更新」）。"
		return 0
	fi

	log "规则集检查：共 ${total} 条远程规则集，其中 ${missing} 条本地缺失或无效，正在预下载（最多约 4 分钟）…"

	# 用「标记文件 + 退出码文件」而不是 kill -0 来判断下载是否结束：
	# 某些 shell 的 kill -0 对后台兄弟进程并不可靠，一旦判断失败，等待循环
	# 会一次都不执行，用户就只能等下载全部结束后才看到结果。
	# 下载明细不再 tail 进主日志：日志页现在直接读 ruleset_download.log
	# （ACL 已授读），tail 只会制造两份相同的行；失败摘要仍随 stdout 落进
	# 主日志，结论不受影响。
	local rs_rc rs_waited rs_pid
	local rs_flag="$RUN_DIR/.ruleset_running"
	local rs_rcf="$RUN_DIR/.ruleset_rc"
	rm -f "$rs_rcf" 2>/dev/null
	: > "$rs_flag" 2>/dev/null

	# fetch_rulesets.sh prints its failure summary to stdout, so redirecting it
	# here lands it in homeproxy.log directly.
	# trap '' HUP：start_service 返回后 procd 或调用方的 shell 退出时会向
	# 进程组发 SIGHUP，后台下载会被无声掐断（前台看只剩半截日志）。
	# 这里忽略它，保证 21 条规则集能跑完（脚本自身不依赖 nohup）。
	(
		trap '' HUP
		/bin/sh "$ruleset_script" --budget 240 >>"$LOG_PATH" 2>&1
		echo $? > "$rs_rcf"
		rm -f "$rs_flag"
	) &
	rs_pid=$!

	# 等待下载结束（带上限，避免标记文件残留时把服务启动卡死）。
	# 只等下载这一个后台任务：无参 wait 会连更早启动的面板预下载一起等，
	# 把服务启动拖到面板下载完成为止。
	rs_waited=0
	while [ -f "$rs_flag" ] && [ "$rs_waited" -lt 400 ]; do
		sleep 2
		rs_waited=$((rs_waited + 2))
	done
	wait "$rs_pid" 2>/dev/null

	rs_rc=$(cat "$rs_rcf" 2>/dev/null)
	case "$rs_rc" in ''|*[!0-9]*) rs_rc=1 ;; esac

	rm -f "$rs_flag" "$rs_rcf" 2>/dev/null

	if [ "$rs_rc" -eq 75 ]; then
		# 75 = fetch_rulesets.sh 让路（另一个下载任务正在跑）。
		log "规则集检查：另一个规则集下载任务正在运行，本次跳过补齐（不影响服务启动）。"
		return 0
	fi

	if [ "$rs_rc" -eq 0 ]; then
		log "规则集预下载完成：${missing} 条缺失已补齐。"
	else
		log "【规则集下载失败】预下载未全部成功（失败项见上方明细及 $RUN_DIR/ruleset_download.log）。失败项将由内核按 remote 方式下载；若 URL 返回 404，内核会把它当 .srs 载入并崩溃，导致服务起不来。请检查失败项 URL：geoip-* 公司/服务类域名规则应改为 geosite-*，或手动下载正确 .srs 放到 $HP_DIR/ruleset。"
		panel_log "规则集有下载失败项，已在主日志提示处理办法（geoip-* 公司/服务类应改为 geosite-*）。"
	fi

	return 0
}

start_service() {
	init_logs

	# sing-box 默认以 root 运行即可（iStoreOS 等 busybox 环境无 adduser/
	# addgroup，创建专用用户必然失败）；不再主动创建用户，也不打印提示。
	# 若系统已存在 sing-box 用户，下方 ujail 分支（have_sing_box_user 判断）
	# 仍会自动降权。

	# Avoid stamping startup log lines with the pre-NTP (sysfixtime) clock.
	wait_for_time_sync

	# Ensure the reF1nd sing-box core for this architecture is installed.
	# HomeProxy no longer bundles a single-arch binary; the correct build is
	# fetched at runtime. If no binary exists and the architecture is not yet
	# supported (or the download fails), do not start the service.
	if [ -f "$CORE_SCRIPT" ]; then
		# Defensive: a package built on a Windows host with core.autocrlf=true
		# can ship this helper with CRLF endings. busybox ash then dies at parse
		# time ("Syntax error: word unexpected (expecting \"in\")") and produces
		# ZERO output and an EMPTY core_download.log — which looks exactly like a
		# download failure. Strip a stray trailing CR before running so the
		# helper always parses, regardless of how it was packaged.
		if [ "$(tr -cd '\r' < "$CORE_SCRIPT" 2>/dev/null | wc -c)" -gt 0 ]; then
			if tr -d '\r' < "$CORE_SCRIPT" > "${CORE_SCRIPT}.lf" 2>/dev/null \
				&& mv -f "${CORE_SCRIPT}.lf" "$CORE_SCRIPT" 2>/dev/null; then
				log "警告：检测到内核脚本含 CRLF 换行，已自动修正为 LF。"
			fi
		fi

		# Invoke through /bin/sh explicitly so a lost executable bit (e.g. a
		# Windows checkout that dropped the mode) cannot silently disable the
		# runtime core download. Capture the helper's own stdout/stderr to a
		# dedicated file: if core_download.log ends up empty (script aborted
		# before its first log write, missing interpreter, parse error, ...),
		# we can still surface the real cause instead of a generic message.
		local core_out="$RUN_DIR/core_ensure.out"
		if ! /bin/sh "$CORE_SCRIPT" ensure >"$core_out" 2>&1; then
			# 1) Prefer a concrete per-mirror reason from core_download.log
			#    (e.g. "下载失败（返回码 60）"). 2) If that log has nothing
			#    useful, fall back to the helper's own stdout/stderr. 3) Only
			#    then use the generic hint.
			local reason
			reason="$(tail -n 40 "$RUN_DIR/core_download.log" 2>/dev/null \
				| grep -E '下载失败|错误|返回码|reF1nd 内核缺失|reF1nd 内核下载|暂不支持|未找到' \
				| tail -n 1 | sed 's/^.*download : //')"
			if [ -z "$reason" ]; then
				reason="$(tail -n 3 "$core_out" 2>/dev/null | tr '\n' ' ' \
					| sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//')"
			fi
			[ -n "$reason" ] || reason="下载失败或架构暂不支持"
			log "错误：sing-box 内核不可用：${reason}。请查看 $RUN_DIR/core_download.log，或手动将内核放到 /usr/bin/sing-box 并 chmod 755。"
			panel_log "面板未下载：sing-box 内核不可用，服务未启动（面板依赖内核运行）。"
			return 1
		fi
	else
		log "错误：内核下载脚本 $CORE_SCRIPT 缺失。"
		panel_log "面板未下载：内核下载脚本缺失，服务未启动（面板依赖内核运行）。"
		return 1
	fi

	# 提前下载面板：本地预下载不依赖服务是否真正启动，放在「无节点/服务端未启用」
	# 提前返回之前，避免半配置路由器永远下不到面板。后台执行以免拖慢服务启动。
	( prefetch_panel ) &

	config_load "$CONF"

	# 自证：配置读不出来时 /lib/functions.sh 会把整包当成空的，之后每一个
	# config_get 都静默返回默认值 —— outbound_node 变成 "nil"，于是流程走到
	# 下面「未配置代理节点且服务端未启用」的早退分支：一个 procd 实例都不建、
	# 规则集也不同步，而日志通篇说「没配置」，与现实恰好相反。
	# 0.1.19 现场就是这种形态：配置里 21 条 enabled=1/remote 的规则集、上百个
	# 节点，日志却报「当前没有已启用的远程规则集」+「未配置代理节点」，且没有
	# 任何一行报错可查。这里把「读不到」与「真的没配」明确区分开。
	local conf_secs
	conf_secs="$(uci -q show "$CONF" 2>/dev/null | grep -c '=')"
	case "$conf_secs" in ''|*[!0-9]*) conf_secs=0 ;; esac
	if [ "$conf_secs" -eq 0 ]; then
		if ! command -v uci >/dev/null 2>&1; then
			log "错误：找不到 uci 命令（运行环境 PATH 不完整），无法读取配置 /etc/config/$CONF。"
		else
			log "错误：读取不到配置 /etc/config/$CONF（uci show 返回 0 个条目）。文件可能不存在、为空或存在语法错误，此时所有配置项都会按默认值处理，服务不会启动。请执行「uci show $CONF」查看具体报错，或用备份恢复该文件。"
		fi
		panel_log "配置读取失败：/etc/config/$CONF 无法解析（详见 $LOG_PATH）。"
		return 1
	fi

	setup_auto_update_cron

	# 「保存并应用」走 reload_service() = stop + start，同样会执行到这里，
	# 所以点保存并应用就会检查并补齐规则集：本地已有有效副本的跳过，
	# 缺失/无效的才下载。放在早退判定之前，未配置节点时也会同步。
	sync_rulesets

	local routing_mode proxy_mode
	config_get routing_mode "config" "routing_mode" "bypass_mainland_china"
	config_get proxy_mode "config" "proxy_mode" "redirect_tproxy"

	local cache_path
	config_get cache_path "cache" "path" "$HP_DIR/cache.db"
	mkdir -p "$(dirname "$cache_path")"
	[ -e "$cache_path" ] || touch "$cache_path"
	chown sing-box:sing-box "$cache_path" 2>"/dev/null"

	local outbound_node
	if [ "$routing_mode" != "custom" ]; then
		config_get outbound_node "config" "main_node" "nil"
	else
		config_get outbound_node "routing" "default_outbound" "nil"
	fi

	local server_enabled
	config_get_bool server_enabled "server" "enabled" "0"

	if [ "$outbound_node" = "nil" ] && [ "$server_enabled" = "0" ]; then
		# No entry node and no server: nothing to run, so start_service returns
		# before the instances are created and long before ensure_panel().
		# Say so in the panel log, otherwise its emptiness looks like a bug.
		panel_log "面板未下载：未配置代理节点且服务端未启用，服务未启动（面板依赖内核运行）。"
		return 1
	fi

	# The core's TZ has to be a TZif path or an IANA name; see tz_setup_core().
	# Runs only when something will actually be started, so an idle config does
	# not fill the log with notices about a core that never runs.
	tz_setup_core

	if [ "$outbound_node" != "nil" ]; then
		# Generate/Validate client config
		# Capture ucode's stderr to the log with ANSI escapes stripped.
		append_err_stripped ucode -S "$HP_DIR/scripts/generate_client.uc"

		if [ ! -e "$RUN_DIR/sing-box-c.json" ]; then
			log "错误：生成客户端配置失败。"
			panel_log "面板未下载：生成客户端配置失败，服务未启动（面板依赖内核运行）。详情见 $LOG_PATH。"
			return 1
		elif ! append_err_stripped "$PROG" check --config "$RUN_DIR/sing-box-c.json"; then
			log "错误：检测到客户端配置有误。"
			panel_log "面板未下载：sing-box 配置校验失败，服务未启动（面板依赖内核运行）。详情见 $LOG_PATH。"
			# A config pasted from a backup that was saved as GBK/ANSI is the
			# most common way to get here with a "working" config: the labels
			# are invalid UTF-8, so the generated core config is rejected.
			panel_log "提示：若配置是从备份粘贴的，请确认 /etc/config/$CONF 为 UTF-8 编码（GBK 备份会让生成的配置含非法字节）。"
			# A remote rule-set whose URL 404s earlier is the classic cause of
			# a config that looks valid in LuCI but aborts the core on load
			# (the HTML error page is stored as a bogus .srs and crashes the
			# binary decoder). Point the user at it instead of leaving a bare
			# "config error" with no actionable cause.
			if grep -qE '下载失败|404|不存在' "$RUN_DIR/ruleset_download.log" 2>/dev/null; then
				log "提示：规则集下载日志中存在失败/404 记录，内核校验失败很可能是某条 remote 规则集 URL 无效（如 geoip-* 公司/服务类应改 geosite-*）所致。请检查 $RUN_DIR/ruleset_download.log。"
				panel_log "提示：规则集下载失败/404 可能导致内核校验失败，请检查失败项 URL（geoip-* 公司/服务类应改 geosite-*）。"
			fi
			return 1
		fi

		# DNSMasq rules
		local ipv6_support dns_port
		config_get_bool ipv6_support "config" "ipv6_support" "0"
		config_get dns_port "infra" "dns_port" "5333"
		mkdir -p "$DNSMASQ_DIR"
		echo -e "conf-dir=$DNSMASQ_DIR" > "$DNSMASQ_DIR/../dnsmasq-homeproxy.conf"
		case "$routing_mode" in
		"bypass_mainland_china"|"custom"|"global")
			cat <<-EOF >> "$DNSMASQ_DIR/redirect-dns.conf"
				no-poll
				no-resolv
				server=127.0.0.1#$dns_port
			EOF
			;;
		"gfwlist")
			local gfw_nftset_v6
			[ "$ipv6_support" -eq "0" ] || gfw_nftset_v6=",6#inet#fw4#homeproxy_gfw_list_v6"
			sed -r -e "s/(.*)/server=\/\1\/127.0.0.1#$dns_port\nnftset=\/\1\\/4#inet#fw4#homeproxy_gfw_list_v4$gfw_nftset_v6/g" \
				"$HP_DIR/resources/gfw_list.txt" > "$DNSMASQ_DIR/gfw_list.conf"
			;;
		"proxy_mainland_china")
			sed -r -e "s/(.*)/server=\/\1\/127.0.0.1#$dns_port/g" \
				"$HP_DIR/resources/china_list.txt" > "$DNSMASQ_DIR/china_list.conf"
			;;
		esac

		if [ "$routing_mode" != "custom" ] && [ -s "$HP_DIR/resources/proxy_list.txt" ]; then
			local wan_nftset_v6
			[ "$ipv6_support" -eq "0" ] || wan_nftset_v6=",6#inet#fw4#homeproxy_wan_proxy_addr_v6"
			sed -r -e '/^\s*$/d' -e "s/(.*)/server=\/\1\/127.0.0.1#$dns_port\nnftset=\/\1\\/4#inet#fw4#homeproxy_wan_proxy_addr_v4$wan_nftset_v6/g" \
				"$HP_DIR/resources/proxy_list.txt" > "$DNSMASQ_DIR/proxy_list.conf"
		fi
		# Setup routing table
		local table_mark
		config_get table_mark "infra" "table_mark" "100"
		case "$proxy_mode" in
		"redirect_tproxy")
			local outbound_udp_node
			config_get outbound_udp_node "config" "main_udp_node" "nil"
			if [ "$outbound_udp_node" != "nil" ] || [ "$routing_mode" = "custom" ]; then
				local tproxy_mark
				config_get tproxy_mark "infra" "tproxy_mark" "101"

				ip rule add fwmark "$tproxy_mark" table "$table_mark"
				ip route add local 0.0.0.0/0 dev lo table "$table_mark"

				if [ "$ipv6_support" -eq "1" ]; then
					ip -6 rule add fwmark "$tproxy_mark" table "$table_mark"
					ip -6 route add local ::/0 dev lo table "$table_mark"
				fi
			fi
			;;
		"redirect_tun"|"tun")
			local tun_name tun_mark
			config_get tun_name "infra" "tun_name" "singtun0"
			config_get tun_mark "infra" "tun_mark" "102"

			ip tuntap add mode tun user root name "$tun_name"
			sleep 1s
			ip link set "$tun_name" up

			ip route replace default dev "$tun_name" table "$table_mark"
			ip rule add fwmark "$tun_mark" lookup "$table_mark"

			ip -6 route replace default dev "$tun_name" table "$table_mark"
			ip -6 rule add fwmark "$tun_mark" lookup "$table_mark"
			;;
		esac

		# sing-box (client)
		procd_open_instance "sing-box-c"

		procd_set_param command "$PROG"
		procd_append_param command run --config "$RUN_DIR/sing-box-c.json"

		# Both variables must go into ONE procd_set_param env call: procd keeps
		# a single "env" object per instance, so a second call silently drops
		# the first one's variables.
		#   TZ  — sing-box is Go and needs a TZif path or an IANA name
		#         (see tz_setup_core); the POSIX string from /etc/TZ is
		#         silently ignored, which used to leave the core on UTC.
		#   GSO — QUIC-GO GSO is broken on kernel 6.6 currently.
		if uname -r | grep -Eq "^6\.6"; then
			procd_set_param env "TZ"="$CORE_TZ" "QUIC_GO_DISABLE_GSO"="true"
		else
			procd_set_param env "TZ"="$CORE_TZ"
		fi

		if have_sing_box_user && [ -x "/sbin/ujail" ] && [ "$routing_mode" != "custom" ] && ! grep -Eq '"type": "(wireguard|tun)"' "$RUN_DIR/sing-box-c.json"; then
			procd_add_jail "sing-box-c" log procfs
			procd_add_jail_mount "$RUN_DIR/sing-box-c.json"
			procd_add_jail_mount_rw "$RUN_DIR/sing-box-c.log"
			procd_add_jail_mount_rw "$cache_path"
			procd_add_jail_mount_rw "$HP_DIR/run/"
			procd_add_jail_mount "$HP_DIR/certs/"
			procd_add_jail_mount "/etc/ssl/"
			procd_add_jail_mount "/etc/localtime"
			procd_add_jail_mount "/etc/TZ"
			# The TZ we hand the core may live outside the jail's view.
			case "$CORE_TZ" in
				:/usr/share/zoneinfo/*) procd_add_jail_mount "/usr/share/zoneinfo" ;;
				:*"$RUN_DIR"*) procd_add_jail_mount "$RUN_DIR/core.zone" ;;
			esac
			procd_set_param capabilities "/etc/capabilities/homeproxy.json"
			procd_set_param no_new_privs 1
			procd_set_param user sing-box
			procd_set_param group sing-box
		fi

		procd_set_param limits core="unlimited"
		procd_set_param limits nofile="1000000 1000000"
		procd_set_param stderr 1
		procd_set_param respawn

		procd_close_instance
	fi

	if [ "$server_enabled" = "1" ]; then
		# Generate/Validate server config
		# Capture ucode's stderr to the log with ANSI escapes stripped.
		append_err_stripped ucode -S "$HP_DIR/scripts/generate_server.uc"

		if [ ! -e "$RUN_DIR/sing-box-s.json" ]; then
			log "错误：生成服务端配置失败。"
			return 1
		elif ! append_err_stripped "$PROG" check --config "$RUN_DIR/sing-box-s.json"; then
			log "错误：检测到服务端配置有误。"
			return 1
		fi

		# sing-box (server)
		procd_open_instance "sing-box-s"

		procd_set_param command "$PROG"
		procd_append_param command run --config "$RUN_DIR/sing-box-s.json"

		# Both variables must go into ONE procd_set_param env call: procd keeps
		# a single "env" object per instance, so a second call silently drops
		# the first one's variables.
		#   TZ  — sing-box is Go and needs a TZif path or an IANA name
		#         (see tz_setup_core); the POSIX string from /etc/TZ is
		#         silently ignored, which used to leave the core on UTC.
		#   GSO — QUIC-GO GSO is broken on kernel 6.6 currently.
		if uname -r | grep -Eq "^6\.6"; then
			procd_set_param env "TZ"="$CORE_TZ" "QUIC_GO_DISABLE_GSO"="true"
		else
			procd_set_param env "TZ"="$CORE_TZ"
		fi

		if have_sing_box_user && [ -x "/sbin/ujail" ]; then
			procd_add_jail "sing-box-s" log procfs
			procd_add_jail_mount "$RUN_DIR/sing-box-s.json"
			procd_add_jail_mount_rw "$RUN_DIR/sing-box-s.log"
			procd_add_jail_mount_rw "$HP_DIR/certs/"
			procd_add_jail_mount "/etc/acme/"
			procd_add_jail_mount "/etc/ssl/"
			procd_add_jail_mount "/etc/localtime"
			procd_add_jail_mount "/etc/TZ"
			# The TZ we hand the core may live outside the jail's view.
			case "$CORE_TZ" in
				:/usr/share/zoneinfo/*) procd_add_jail_mount "/usr/share/zoneinfo" ;;
				:*"$RUN_DIR"*) procd_add_jail_mount "$RUN_DIR/core.zone" ;;
			esac
			procd_set_param capabilities "/etc/capabilities/homeproxy.json"
			procd_set_param no_new_privs 1
			procd_set_param user sing-box
			procd_set_param group sing-box
		fi

		procd_set_param limits core="unlimited"
		procd_set_param limits nofile="1000000 1000000"
		procd_set_param stderr 1
		procd_set_param respawn

		procd_close_instance
	fi

	# log-cleaner
	procd_open_instance "log-cleaner"
	procd_set_param command /bin/sh "$HP_DIR/scripts/clean_log.sh"
	procd_set_param respawn
	procd_close_instance

	case "$routing_mode" in
	"custom")
		# Prepare ruleset directory
		[ -d "$HP_DIR/ruleset" ] || mkdir -p "$HP_DIR/ruleset"
		;;
	esac

	[ "$outbound_node" = "nil" ] || : > "$RUN_DIR/sing-box-c.log"
	if [ "$server_enabled" = "1" ]; then
		: > "$RUN_DIR/sing-box-s.log"
		mkdir -p "$HP_DIR/certs"
	fi

	# Update permissions for ujail
	chown -R sing-box:sing-box "$RUN_DIR" 2>"/dev/null"

	# Setup firewall
	ucode "$HP_DIR/scripts/firewall_pre.uc"
	[ "$outbound_node" = "nil" ] || utpl -S "$HP_DIR/scripts/firewall_post.ut" > "$RUN_DIR/fw4_post.nft"
	fw4 reload >"/dev/null" 2>&1
	/etc/init.d/dnsmasq restart >"/dev/null" 2>&1

	log "sing-box $(sing-box version -n) 已启动。"

	# Auto-install the dashboard panel after the core is up, the same way the
	# kernel is fetched at start. Run detached so service start is not blocked
	# while the core boots and the clash API becomes reachable.
	( ensure_panel ) &
}

stop_service() {
	sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>"/dev/null"
	/etc/init.d/cron restart >"/dev/null" 2>&1

	# Setup firewall
	# Load config
	config_load "$CONF"
	local table_mark tproxy_mark tun_mark tun_name
	config_get table_mark "infra" "table_mark" "100"
	config_get tproxy_mark "infra" "tproxy_mark" "101"
	config_get tun_mark "infra" "tun_mark" "102"
	config_get tun_name "infra" "tun_name" "singtun0"

	# Tproxy
	ip rule del fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null"
	ip route del local 0.0.0.0/0 dev lo table "$table_mark" 2>"/dev/null"
	ip -6 rule del fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null"
	ip -6 route del local ::/0 dev lo table "$table_mark" 2>"/dev/null"

	# TUN
	ip route del default dev "$tun_name" table "$table_mark" 2>"/dev/null"
	ip rule del fwmark "$tun_mark" table "$table_mark" 2>"/dev/null"

	ip -6 route del default dev "$tun_name" table "$table_mark" 2>"/dev/null"
	ip -6 rule del fwmark "$tun_mark" table "$table_mark" 2>"/dev/null"

	# Nftables rules
	for i in "homeproxy_dstnat_redir" "homeproxy_output_redir" \
		 "homeproxy_redirect" "homeproxy_redirect_proxy" \
		 "homeproxy_redirect_proxy_port" "homeproxy_redirect_lanac" \
		 "homeproxy_mangle_prerouting" "homeproxy_mangle_output" \
		 "homeproxy_mangle_tproxy" "homeproxy_mangle_tproxy_port" \
		 "homeproxy_mangle_tproxy_lanac" "homeproxy_mangle_mark" \
		 "homeproxy_mangle_tun" "homeproxy_mangle_tun_mark"; do
		nft flush chain inet fw4 "$i"
		nft delete chain inet fw4 "$i"
	done 2>"/dev/null"
	for i in "homeproxy_local_addr_v4" "homeproxy_local_addr_v6" \
		 "homeproxy_gfw_list_v4" "homeproxy_gfw_list_v6" \
		 "homeproxy_mainland_addr_v4" "homeproxy_mainland_addr_v6" \
		 "homeproxy_wan_proxy_addr_v4" "homeproxy_wan_proxy_addr_v6" \
		 "homeproxy_wan_direct_addr_v4" "homeproxy_wan_direct_addr_v6" \
		 "homeproxy_routing_port"; do
		nft flush set inet fw4 "$i"
		nft delete set inet fw4 "$i"
	done 2>"/dev/null"
	echo 2>"/dev/null" > "$RUN_DIR/fw4_forward.nft"
	echo 2>"/dev/null" > "$RUN_DIR/fw4_input.nft"
	echo 2>"/dev/null" > "$RUN_DIR/fw4_post.nft"
	fw4 reload >"/dev/null" 2>&1

	# Remove DNS hijack
	rm -rf "$DNSMASQ_DIR/../dnsmasq-homeproxy.conf" "$DNSMASQ_DIR"
	/etc/init.d/dnsmasq restart >"/dev/null" 2>&1

	rm -f "$RUN_DIR/sing-box-c.json" "$RUN_DIR/sing-box-s.json"
	init_logs

	log "服务已停止。"
}

service_stopped() {
	# Load config
	config_load "$CONF"
	local tun_name
	config_get tun_name "infra" "tun_name" "singtun0"

	# TUN
	ip link set "$tun_name" down 2>"/dev/null"
	ip tuntap del mode tun name "$tun_name" 2>"/dev/null"
}

reload_service() {
	log "正在重新加载服务..."

	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/$CONF reload
}
