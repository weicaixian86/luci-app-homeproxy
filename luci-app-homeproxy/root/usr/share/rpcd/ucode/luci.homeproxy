'use strict';

import { access, lstat, popen, readfile, unlink, writefile } from 'fs';
import { cursor } from 'uci';

/* Kanged from ucode/luci */
function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

function hasKernelModule(kmod) {
	return (system(sprintf('[ -e "/lib/modules/$(uname -r)"/%s ]', shellquote(kmod))) === 0);
}

const HP_DIR = '/etc/homeproxy';
const RUN_DIR = '/var/run/homeproxy';

function getClashAPIConfig(uci) {
	const external_controller = trim(uci.get('homeproxy', 'clash_api', 'external_controller') || '127.0.0.1:9090');
	const secret = trim(uci.get('homeproxy', 'clash_api', 'secret') || '');
	const matched = match(external_controller, /:([0-9]+)$/);
	const port = matched ? matched[1] : '9090';

	return {
		base_url: `http://127.0.0.1:${port}`,
		port,
		secret
	};
}

function readProcess(fd) {
	let payload = '', line;
	for (line = fd.read('line'); length(line); line = fd.read('line'))
		payload += line;
	fd.close();

	return payload;
}

/* Clash API 请求统一走这两个包装：curl 是包的硬依赖（Makefile 的
   LUCI_DEPENDS 里有 +curl），wget 只是精简镜像里可能存在的替代品。
   原来这里把 /usr/bin/wget 写死，镜像里没有 wget 时面板下载、延迟测试
   和「当前节点」查询都会静默失败。两个都没有时返回 null，上层沿用
   已有的 clash_api_unavailable 分支，不会冒出一个误导性的「未知错误」。 */
function httpClient() {
	/* 三个路径都要查：iStoreOS 的 curl 装在 /usr/sbin，OpenWrt 常规包在
	   /usr/bin，精简镜像可能是 /bin 的软链。只查前两个曾导致面板下载与
	   延迟测试静默失败。 */
	for (let path in ['/usr/bin/curl', '/usr/sbin/curl', '/bin/curl'])
		if (access(path))
			return { kind: 'curl', path: path };

	for (let path in ['/usr/bin/wget', '/bin/wget'])
		if (access(path))
			return { kind: 'wget', path: path };

	return null;
}

function httpCommand(url, timeout, header, post) {
	const client = httpClient();

	if (!client)
		return null;

	const t = timeout || 10;
	const auth = header ? sprintf('--header %s ', shellquote(header)) : '';

	if (client.kind === 'curl')
		/* 不加 -f：Clash API 在 4xx/5xx 时也会返回带 message 的 JSON，
		   这正是上层用来区分「超时 / 无效 outbound / 未知错误」的依据。 */
		return sprintf(`%s -sS --connect-timeout 5 --max-time %d %s%s%s 2>"/dev/null"`,
			client.path, t, auth,
			post ? "--request POST --data '' " : '',
			shellquote(url));

	return sprintf(`%s -qO- -T %d %s%s%s 2>"/dev/null"`,
		client.path, t, auth,
		post ? "--post-data='' " : '',
		shellquote(url));
}

function clashAPIRequest(api, method, path, timeout) {
	const cmd = httpCommand(api.base_url + path, timeout || 10,
		api.secret ? `Authorization: Bearer ${api.secret}` : null,
		method === 'POST');

	if (!cmd)
		return null;

	const fd = popen(cmd);

	if (!fd)
		return null;

	const payload = readProcess(fd);

	/* An empty body means wget failed to connect (the core is not running, so
	 * the Clash API on 127.0.0.1:<port> is down). Return null so callers report
	 * "clash_api_unavailable" instead of letting a bogus empty JSON parse fail
	 * and surface as a misleading "unknown error". */
	return length(payload) ? payload : null;
}

/* Append a timestamped panel-download event to the dedicated runtime log
   file so it is visible in the HomeProxy "Logs" page, and also keep a syslog
   copy for system-level debugging. */
function panelLog(msg) {
	const line = sprintf('面板: %s', msg);
	system(sprintf('mkdir -p /var/run/homeproxy 2>/dev/null; printf "%%s %%s\\n" "$(date "+%%Y-%%m-%%d %%H:%%M:%%S")" %s >> /var/run/homeproxy/panel_download.log 2>/dev/null; logger -t homeproxy %s', shellquote(line), shellquote(line)));
}

/* external_ui 是用户自由输入的路径，随后会被 `rm -rf` / `mv` 直接操作
   （preparePanelBackup / restorePanelBackup / clash_api_install_panel）。
   一旦填成 `/`、`/etc`、`/usr`，安装或更新面板就会搬走/删除系统目录。
   规则：
     - 必须是绝对路径，至少两级（/a/b），且不含 `..` 回溯；
     - 只能是 root 之外的常规目录；
     - 系统目录一律拒绝；`/etc` 下只允许 /etc/homeproxy/**。
   不合规时回落到默认目录并写一条面板日志，绝不带着危险路径去执行。 */
const PROTECTED_PATH_PREFIXES = ['/bin/', '/sbin/', '/lib/', '/usr/', '/proc/',
	'/sys/', '/dev/', '/overlay/', '/rom/', '/boot/', '/tmp/', '/var/'];

function sanitizePanelDir(raw) {
	const fallback = `${HP_DIR}/run/ui`;
	const dir = trim(raw || '');

	if (!length(dir) || !match(dir, /^\//))
		return fallback;

	let normalized = replace(dir, /\/+/g, '/');
	normalized = replace(normalized, /\/\.\//g, '/');
	normalized = replace(normalized, /\/$/, '');

	if (!length(normalized) || match(normalized, /(^|\/)\.\.($|\/)/))
		return fallback;

	/* 至少两级：/etc、/mnt 这种一级目录本身不允许当面板目录 */
	if (!match(normalized, /^\/[^\/]+\/[^\/]+/))
		return fallback;

	for (let prefix in PROTECTED_PATH_PREFIXES) {
		if (substr(normalized, 0, length(prefix)) === prefix)
			return fallback;
	}

	/* /etc 下只放行本应用自己的目录 */
	if (match(normalized, /^\/etc\//) && !match(normalized, /^\/etc\/homeproxy\//))
		return fallback;

	return normalized;
}

function getPanelDir(uci) {
	const raw = trim(uci.get('homeproxy', 'clash_api', 'external_ui') || '');
	const dir = sanitizePanelDir(raw);

	if (length(raw) && dir !== trim(replace(raw, /\/+$/g, '')))
		panelLog(sprintf('外部面板路径不安全，已忽略（%s），改用默认目录 %s', raw, dir));

	return dir;
}

function hasDirectoryContent(directory) {
	return (system(`[ -d ${shellquote(directory)} ] && [ -n "$(ls -A ${shellquote(directory)} 2>/dev/null)" ]`) === 0);
}

function preparePanelBackup(panel_dir, backup_dir) {
	const parent_dir = replace(panel_dir, /\/[^/]+$/, '') || '/';

	system(`rm -rf ${shellquote(backup_dir)}`);
	system(`mkdir -p ${shellquote(parent_dir)}`);

	if (hasDirectoryContent(panel_dir)) {
		if (system(`mv ${shellquote(panel_dir)} ${shellquote(backup_dir)}`) !== 0)
			return false;
	}

	return (system(`mkdir -p ${shellquote(panel_dir)}`) === 0);
}

function restorePanelBackup(panel_dir, backup_dir) {
	if (!access(backup_dir))
		return true;

	system(`rm -rf ${shellquote(panel_dir)}`);
	return (system(`mv ${shellquote(backup_dir)} ${shellquote(panel_dir)}`) === 0);
}

function cleanupPanelBackup(backup_dir) {
	system(`rm -rf ${shellquote(backup_dir)}`);
}

/* ---------------------------------------------------------------------------
 * Async core update
 *
 * A 34 MB core tarball takes 4-33 minutes on the mirrors we ship, while the
 * uhttpd request that triggers it survives tens of seconds at most. The update
 * therefore runs detached (update_core_async.sh) and the UI polls
 * singbox_core_progress: singbox_core_update returns immediately, so a dropped
 * HTTP connection can no longer kill the download halfway through — which is
 * what produced the earlier "failed, and the log is empty" reports.
 * ------------------------------------------------------------------------ */

function coreUpdateRunning() {
	let pid = '';

	try {
		pid = trim(readfile(`${RUN_DIR}/core_update.pid`) || '');
	} catch (e) {
		return false;
	}

	/* Only a plain number may reach the shell. A pid file whose process is
	 * gone (helper killed, router rebooted) reports "not running" so the UI
	 * can never wait forever on a stale file. */
	if (!length(pid) || !match(pid, /^[0-9]+$/))
		return false;

	return (system(`kill -0 ${pid} 2>/dev/null`) === 0);
}

function coreDownloadLogTail(count) {
	let tail = '';

	try {
		const raw = readfile(`${RUN_DIR}/core_download.log`);
		if (raw) {
			const lines = split(raw, '\n');
			let n = 0;
			for (let i = length(lines) - 1; i >= 0 && n < count; i--) {
				const l = trim(lines[i]);
				if (length(l)) {
					tail = l + '\n' + tail;
					n++;
				}
			}
		}
	} catch (e) {}

	return trim(tail);
}

function coreUpdateOutput() {
	try {
		return trim(readfile(`${RUN_DIR}/core_update.out`) || '');
	} catch (e) {
		return '';
	}
}

const methods = {
	acllist_read: {
		args: { type: 'string' },
		call: function(req) {
			if (index(['direct_list', 'proxy_list'], req.args?.type) === -1)
				return { content: null, error: 'illegal type' };

			const filecontent = readfile(`${HP_DIR}/resources/${req.args?.type}.txt`);
			return { content: filecontent };
		}
	},
	acllist_write: {
		args: { type: 'string', content: 'string' },
		call: function(req) {
			if (index(['direct_list', 'proxy_list'], req.args?.type) === -1)
				return { result: false, error: 'illegal type' };

			const file = `${HP_DIR}/resources/${req.args?.type}.txt`;
			let content = req.args?.content;

			/* Sanitize content */
			if (content) {
				content = trim(content);
				content = replace(content, /\r\n/g, '\n');
				content = replace(content, /\r/g, '\n');
				if (!match(content, /\n$/))
					content += '\n';
			}

			system(`mkdir -p ${HP_DIR}/resources`);
			writefile(file, content);

			return { result: true };
		}
	},

	certificate_write: {
		args: { filename: 'string' },
		call: function(req) {
			const writeCertificate = (filename, priv) => {
				const tmpcert = '/tmp/homeproxy_certificate.tmp';
				const filestat = lstat(tmpcert);

				if (!filestat || filestat.type !== 'file' || filestat.size <= 0) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'empty certificate file' };
				}

				let filecontent = readfile(tmpcert);
				if (is_binary(filecontent)) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'illegal file type: binary' };
				}

				/* Kanged from luci-proto-openconnect */
				const beg = priv ? /^-----BEGIN (RSA|EC) PRIVATE KEY-----$/ : /^-----BEGIN CERTIFICATE-----$/,
				      end = priv ? /^-----END (RSA|EC) PRIVATE KEY-----$/ : /^-----END CERTIFICATE-----$/,
				      lines = split(trim(filecontent), /[\r\n]/);
				let start = false, i;

				for (i = 0; i < length(lines); i++) {
					if (match(lines[i], beg))
						start = true;
					else if (start && !b64dec(lines[i]) && length(lines[i]) !== 64)
						break;
				}

				if (!start || i < length(lines) - 1 || !match(lines[i], end)) {
					system(`rm -f ${tmpcert}`);
					return { result: false, error: 'this does not look like a correct PEM file' };
				}

				/* Sanitize certificate */
				filecontent = trim(filecontent);
				filecontent = replace(filecontent, /\r\n/g, '\n');
				filecontent = replace(filecontent, /\r/g, '\n');
				if (!match(filecontent, /\n$/))
					filecontent += '\n';

				system(`mkdir -p ${HP_DIR}/certs`);
				writefile(`${HP_DIR}/certs/${filename}.pem`, filecontent);
				system(`rm -f ${tmpcert}`);

				return { result: true };
			};

			const filename = req.args?.filename;
			switch (filename) {
			case 'client_ca':
			case 'server_publickey':
				return writeCertificate(filename, false);
				break;
			case 'server_privatekey':
				return writeCertificate(filename, true);
				break;
			default:
				return { result: false, error: 'illegal cerificate filename' };
				break;
			}
		}
	},

	connection_check: {
		args: { site: 'string' },
		call: function(req) {
			/* 探测端点与 passwall 完全一致（luci-app-passwall：
			   luasrc/controller/passwall.lua 的 connect_status +
			   luasrc/view/passwall/global/status.htm 的 check_connect）。

			   为什么必须用 favicon.ico / generate_204 而不是站点首页：
			   这里发的是 HEAD 请求，首页会被 WAF/CDN 判成异常客户端。
			   实测 https://www.aliyun.com 的 HEAD 直接返回 403，而
			   /favicon.ico 返回 200；403 虽然也落在 200-599 的「算通」
			   区间里，但拿到的是 WAF 的拒绝页、耗时也完全不同，跟
			   passwall 的数字没法比。 */
			let url;
			switch(req.args?.site) {
			case 'aliyun':
			case 'baidu':
				url = 'https://www.aliyun.com/favicon.ico';
				break;
			case 'google':
				url = 'https://www.google.com/generate_204';
				break;
			case 'github':
				url = 'https://github.com/favicon.ico';
				break;
			case 'youtube':
				url = 'https://www.youtube.com/generate_204';
				break;
			default:
				return { result: false, error: '不支持的测试目标' };
				break;
			}

			/* curl 路径不能写死：iStoreOS 的 curl 在 /usr/sbin。 */
			let curl = null;
			for (let p in ['/usr/bin/curl', '/usr/sbin/curl', '/bin/curl'])
				if (!curl && access(p))
					curl = p;

			if (!curl)
				return { result: false, error: '系统里没有 curl，无法执行连接检查' };

			/* 参数与 passwall 一致：--connect-timeout 3 --max-time 5
			   -o /dev/null -I -sk。特别注意**不要加 -L** —— passwall 不带，
			   而 -L 会让 curl 跟随重定向，time_pretransfer 与
			   time_starttransfer 变成整条重定向链的累计值，算出的
			   「请求延迟」和 passwall 就不是同一个量了。
			   命令用拼接而不是 sprintf：`-w` 的格式串里有 `%{...}`，
			   交给 sprintf 处理会被当成格式说明符。 */
			const cmd = curl
				+ ' --connect-timeout 3 --max-time 5 -o /dev/null -I -sk -w \'%{http_code}:%{time_pretransfer}:%{time_starttransfer}\' '
				+ shellquote(url) + ' 2>"/dev/null"';

			const fd = popen(cmd);
			if (!fd)
				return { result: false, error: '无法执行 curl' };

			const output = trim(readProcess(fd) || '');
			const parts = split(output, ':');
			const code = int(parts[0] || 0);

			/* 与 passwall 相同的口径：handshake = 请求发出之前的耗时
			   （DNS + TCP + TLS，即 time_pretransfer），latency = 服务器
			   响应时间（time_starttransfer - time_pretransfer，只含
			   「请求发出 → 首字节返回」，不含握手）。
			   这就是本项数值明显小于 ping / 节点延迟的原因，passwall 的
			   连接检查也是这个口径，两边因此可以直接对比。
			   中间量用 1e-5 秒的整数，避免浮点误差。 */
			const toCentims = (value) => {
				/* 不用正则（原因见 dns_server_test 里的注释：含 `?` 量词的正则在
				   rpcd 的 ucode 里会抛 “Repetition not preceded by valid
				   expression”，整条探测直接失败）。index + substr 逐字符判断。 */
				const text = trim(`${value || ''}`);
				const dot = index(text, '.');

				if (dot < 0) {
					/* 纯整数秒（curl 偶尔直接给 "1"）：同样按 1e-5 秒换算 */
					if (!length(text))
						return null;

					for (let i = 0; i < length(text); i++)
						if (index('0123456789', substr(text, i, 1)) < 0)
							return null;

					return int(text) * 100000;
				}

				if (dot < 1)
					return null;

				const sec = substr(text, 0, dot),
				      frac = substr(text, dot + 1);

				if (!length(frac) || index(frac, '.') >= 0)
					return null;

				for (let i = 0; i < length(sec); i++)
					if (index('0123456789', substr(sec, i, 1)) < 0)
						return null;
				for (let i = 0; i < length(frac); i++)
					if (index('0123456789', substr(frac, i, 1)) < 0)
						return null;

				const padded = frac + '00000';

				return int(sec) * 100000 + int(substr(padded, 0, 5));
			};

			/* 毫秒展示（"36.04"）：纯字符串拼接，不用 sprintf。
			   ucode 的格式说明符支持范围没有书面保证，`%02d` 一旦不被识别，
			   输出会变成 "36.4" —— 不是排版问题，是**数值本身错了**。 */
			const toMillis = (centims) => {
				const whole = int(centims / 100);
				let frac = `${centims - whole * 100}`;

				while (length(frac) < 2)
					frac = '0' + frac;

				return `${whole}.${frac}`;
			};

			const handshake = toCentims(parts[1]);
			const transfer = toCentims(parts[2]);

			/* 判定条件照抄 passwall：
			   code >= 200 && code < 600 && pretransfer >= 0 &&
			   starttransfer > 0 && starttransfer >= pretransfer
			   任意完整的 HTTP 响应（含 4xx/5xx）都说明链路是通的。 */
			if (code >= 200 && code < 600 && handshake != null && handshake >= 0 && transfer != null && transfer > 0 && transfer >= handshake) {
				return {
					result: true,
					latency: toMillis(transfer - handshake),
					handshake: toMillis(handshake),
					total: toMillis(transfer),
					code,
					type: 'curl'
				};
			}

			return { result: false };
		}
	},

	current_node_get: {
		call: function() {
			const uci = cursor();
			uci.load('homeproxy');

			const formatNode = (section_id, fallback_name) => {
				if (!section_id || section_id in ['nil', 'same'])
					return { id: section_id, label: fallback_name || section_id, type: null };

				const section = uci.get_all('homeproxy', section_id);
				if (!section || section['.type'] !== 'node')
					return { id: section_id, label: fallback_name || section_id, type: null };

				const address = trim(section.override_address || section.address || '');
				const port = trim(section.override_port || section.port || '');
				const label = trim(section.label || '') || ((address && port) ? `${address}:${port}` : section_id);
				return {
					id: section_id,
					label,
					type: section.type || null
				};
			};

			const normalizeOutboundTag = (tag) => {
				if (!tag)
					return null;

				tag = trim(sprintf('%s', tag));
				tag = replace(tag, /[\r\n\t]+/g, ' ');
				tag = replace(tag, /[\/\\?#%]+/g, '-');
				tag = replace(tag, /[ \t\r\n]+/g, ' ');

				return tag || null;
			};

			const sectionDisplayName = (section) => {
				if (!section)
					return null;

				let label = normalizeOutboundTag(section.label);
				if (label)
					return label;

				if (section['.type'] === 'node') {
					const address = trim(section.override_address || section.address || '');
					const port = trim(section.override_port || section.port || '');

					if (address && port)
						return normalizeOutboundTag(`${address}:${port}`);
				}

				return null;
			};

			const buildOutboundTagMap = () => {
				const reserved_tags = {
					'GLOBAL': true,
					'main-out': true,
					'main-udp-out': true,
					'direct-out': true,
					'block-out': true
				};
				let tag_map = {},
				    used_tags = {};

				const register = (section_id, display_name) => {
					if (!section_id || tag_map[section_id])
						return;

					const fallback_tag = `cfg-${section_id}-out`;
					const base_tag = normalizeOutboundTag(display_name) || fallback_tag;
					let tag = base_tag,
					    suffix = 2;

					while (reserved_tags[tag] || used_tags[tag]) {
						tag = `${base_tag} (${suffix})`;
						suffix++;
					}

					tag_map[section_id] = tag;
					used_tags[tag] = true;
				};

				uci.foreach('homeproxy', 'node', (section) => {
					register(section['.name'], sectionDisplayName(section));
				});

				uci.foreach('homeproxy', 'routing_node', (section) => {
					if (section.enabled === '1')
						register(section['.name'], sectionDisplayName(section));
				});

				let reverse_map = {};
				for (let section_id in tag_map)
					reverse_map[tag_map[section_id]] = section_id;

				return reverse_map;
			};

			const main_node = trim(uci.get('homeproxy', 'config', 'main_node') || 'nil');
			if (main_node !== 'urltest')
				return {
					mode: main_node,
					active: formatNode(main_node, (main_node === 'nil') ? '禁用' : null),
					error: null
				};

			const payload = clashAPIRequest(getClashAPIConfig(uci), 'GET', '/proxies/main-out', 3);
			if (payload === null)
				return {
					mode: 'urltest',
					active: { id: 'urltest', label: '自动选择', type: 'urltest' },
					error: 'clash_api_unavailable'
				};

			let data = null;
			try {
				data = json(payload);
			} catch (e) {}

			const tag = trim(data?.now || '');
			if (!tag)
				return {
					mode: 'urltest',
					active: { id: 'urltest', label: '自动选择', type: 'urltest' },
					error: 'missing_current_proxy'
				};

			const tag_map = buildOutboundTagMap();
			const matched = match(tag, /^cfg-(.*)-out$/);
			const section_id = tag_map[tag] || (matched ? matched[1] : tag);

			return {
				mode: 'urltest',
				active: formatNode(section_id, tag),
				error: null
			};
		}
	},
	

	clash_api_update_panel: {
		args: { only_if_missing: true, attempt: 1, total: 1 },
		call: function(request) {
			const uci = cursor();
			uci.load('homeproxy');
			const panel_dir = getPanelDir(uci);
			const backup_dir = `${panel_dir}.backup`;

			const attempt = (request?.args?.attempt && +request.args.attempt) || 1;
			const total = (request?.args?.total && +request.args.total) || attempt;
			const manual_hint = (attempt >= total) ? '; please install the panel manually' : '';

			if (request?.args?.only_if_missing) {
				/* The panel is only enabled in custom and
				   bypass_mainland_china routing modes */
				const routing_mode = trim(uci.get('homeproxy', 'config', 'routing_mode') || '');
				if (routing_mode !== 'custom' && routing_mode !== 'bypass_mainland_china')
					return { result: true, skipped: true };

				const panel_index = lstat(`${panel_dir}/index.html`);
				if (panel_index && panel_index.type === 'file')
					return { result: true, skipped: true };
			}

			/* Try the local fetcher FIRST, before touching the installed panel.
			 * It walks a mirror chain, checks the zip magic before unpacking and
			 * does its own backup/rollback, and it needs neither the core nor the
			 * Clash API — whereas /upgrade/ui is single-source, silent and only
			 * reachable once the core is up. On a line where the configured CDN is
			 * flaky, the fetcher is the only path that can succeed.
			 * Running it before preparePanelBackup() keeps the two backup schemes
			 * from colliding: the script uses the same `<panel_dir>.backup` name. */
			const fetcher = `${HP_DIR}/scripts/fetch_panel.sh`;
			if (system(`test -x ${shellquote(fetcher)}`) === 0) {
				if (system(`/bin/sh ${shellquote(fetcher)} --budget 900`) === 0) {
					const installed = lstat(`${panel_dir}/index.html`);
					if (installed && installed.type === 'file') {
						panelLog(sprintf('下载成功（第 %d 次尝试，本地预下载）', attempt));
						return { result: true };
					}
				}
				panelLog(sprintf('本地预下载未成功（第 %d 次尝试），改由 Clash API 下载', attempt));
			}

			if (!preparePanelBackup(panel_dir, backup_dir))
				return { result: false, error: 'panel_backup_failed' };

			const download_url = uci.get('homeproxy', 'clash_api', 'external_ui_download_url') || '';
			panelLog(sprintf('开始下载（第 %d 次尝试）：%s', attempt, shellquote(download_url)));

			/* /upgrade/ui is synchronous: the core downloads the whole 9.5 MB
			 * archive before answering, and sends nothing in the meantime.
			 * -T is a socket-inactivity timeout, so the budget must cover the
			 * slowest mirror we ship — gh-proxy.com measured 17-132 KB/s, i.e.
			 * up to ~570 s. The old 120 s aborted every download that was
			 * actually progressing, which is why the panel "never downloads"
			 * even when the core is up and reachable. Matches init.d. */
			const payload = clashAPIRequest(getClashAPIConfig(uci), 'POST', '/upgrade/ui', 1200);
			if (payload === null) {
				restorePanelBackup(panel_dir, backup_dir);
				panelLog(sprintf('下载失败（第 %d 次尝试）：Clash API 不可用（超时 1200 秒）%s', attempt, manual_hint));
				return { result: false, error: 'clash_api_unavailable' };
			}

			let data = null;
			try {
				data = json(payload);
			} catch (e) {}

			if (data?.status === 'ok') {
				cleanupPanelBackup(backup_dir);
				panelLog(sprintf('下载成功（第 %d 次尝试）', attempt));
				return { result: true };
			}

			if (!restorePanelBackup(panel_dir, backup_dir))
				return { result: false, error: 'panel_restore_failed' };

			panelLog(sprintf('下载失败（第 %d 次尝试）：%s%s', attempt, shellquote(data?.message || data?.error || 'unknown error'), manual_hint));
			return {
				result: false,
				error: data?.message || data?.error || 'update_panel_failed'
			};
		}
	},
	clash_api_install_panel: {
		call: function() {
			const uci = cursor();
			uci.load('homeproxy');

			const tmpzip = '/tmp/homeproxy_panel.tmp';
			const filestat = lstat(tmpzip);
			if (!filestat || filestat.type !== 'file' || filestat.size <= 0) {
				system(`rm -f ${shellquote(tmpzip)}`);
				return { result: false, error: 'empty_panel_zip' };
			}

			if (system('command -v unzip >/dev/null 2>&1') !== 0) {
				system(`rm -f ${shellquote(tmpzip)}`);
				return { result: false, error: 'unzip_unavailable' };
			}

			const panel_dir = getPanelDir(uci);
			const backup_dir = `${panel_dir}.backup`;
			const extract_dir = '/tmp/homeproxy_panel_extract';
			const stage_dir = '/tmp/homeproxy_panel_stage';
			const install_cmd = `
				set -e
				rm -rf ${shellquote(extract_dir)} ${shellquote(stage_dir)}
				mkdir -p ${shellquote(extract_dir)} ${shellquote(stage_dir)}
				unzip -oq ${shellquote(tmpzip)} -d ${shellquote(extract_dir)} >/dev/null
				src_dir=${shellquote(extract_dir)}
				for depth in 1 2 3; do
					[ -f "$src_dir/index.html" ] && break
					first_entry=""
					entry_count=0
					for entry in "$src_dir"/* "$src_dir"/.[!.]* "$src_dir"/..?*; do
						[ -e "$entry" ] || continue
						case "$(basename "$entry")" in
							__MACOSX|.DS_Store) continue ;;
						esac
						entry_count=$((entry_count + 1))
						[ -n "$first_entry" ] || first_entry="$entry"
					done
					if [ "$entry_count" -eq 1 ] && [ -d "$first_entry" ]; then
						src_dir="$first_entry"
					else
						break
					fi
				done
				copied=0
				for entry in "$src_dir"/* "$src_dir"/.[!.]* "$src_dir"/..?*; do
					[ -e "$entry" ] || continue
					cp -a "$entry" ${shellquote(stage_dir)}/
					copied=1
				done
				[ "$copied" -eq 1 ]
			`;

			if (system(install_cmd) !== 0) {
				system(`rm -f ${shellquote(tmpzip)}`);
				system(`rm -rf ${shellquote(extract_dir)} ${shellquote(stage_dir)}`);
				return { result: false, error: 'invalid_panel_zip' };
			}

			if (!preparePanelBackup(panel_dir, backup_dir)) {
				system(`rm -f ${shellquote(tmpzip)}`);
				system(`rm -rf ${shellquote(extract_dir)} ${shellquote(stage_dir)}`);
				return { result: false, error: 'panel_backup_failed' };
			}

			const replace_cmd = `
				set -e
				rm -rf ${shellquote(panel_dir)}
				mkdir -p ${shellquote(panel_dir)}
				cp -a ${shellquote(stage_dir)}/. ${shellquote(panel_dir)}/
				chown -R sing-box:sing-box ${shellquote(panel_dir)} 2>/dev/null || true
			`;

			let result = { result: true };
			if (system(replace_cmd) !== 0) {
				if (!restorePanelBackup(panel_dir, backup_dir))
					result = { result: false, error: 'panel_restore_failed' };
				else
					result = { result: false, error: 'panel_install_failed' };
			} else {
				cleanupPanelBackup(backup_dir);
			}

			system(`rm -f ${shellquote(tmpzip)}`);
			system(`rm -rf ${shellquote(extract_dir)} ${shellquote(stage_dir)}`);
			return result;
		}
	},

	node_latency_test: {
		args: { node: 'string', mode: 'string' },
		call: function(req) {
			const error_codes = {
				invalid_node: 'invalid_node',
				invalid_mode: 'invalid_mode',
				mode_mismatch: 'mode_mismatch',
				rp_invalid_outbound: 'rp_invalid_outbound',
				rp_runtime_prepare_failed: 'rp_runtime_prepare_failed',
				rp_runtime_launch_failed: 'rp_runtime_launch_failed',
				rp_runtime_timeout: 'rp_runtime_timeout',
				rp_delay_timeout: 'rp_delay_timeout',
				rp_delay_failed: 'rp_delay_failed',
				icmp_probe_unavailable: 'icmp_probe_unavailable',
				icmp_timeout: 'icmp_timeout',
				icmp_failed: 'icmp_failed',
				probe_timeout: 'probe_timeout',
				backend_execution_failed: 'backend_execution_failed',
				probe_failed: 'probe_failed'
			};
			const probe_timeout_s = 3;
			const probe_timeout_ms = probe_timeout_s * 1000;
			const probe_system_timeout_ms = probe_timeout_ms + 250;
			const rp_probe_url = 'https://cp.cloudflare.com/generate_204';
			const rp_probe_url_encoded = 'https%3A%2F%2Fcp.cloudflare.com%2Fgenerate_204';
			const rp_delay_timeout_ms = 5000;

			const formatResult = (node, state, latency_ms, err, extras) => ({
				node,
				state,
				latency_ms,
				measured_at: time(),
				error: err,
				icmp_latency_ms: (extras && extras.icmp_latency_ms != null) ? extras.icmp_latency_ms : null,
				icmp_error: (extras && extras.icmp_error) ? extras.icmp_error : null,
				rp_runtime: (extras && extras.rp_runtime) ? extras.rp_runtime : null
			});

			const strToBool = (str) => ((str === '1') || null);
			const strToInt = (str) => (str != null && trim(sprintf('%s', str)) !== '') ? (int(str) || null) : null;
			const strToTime = (str) => (str != null && trim(sprintf('%s', str)) !== '') ? (str + 's') : null;

			function removeBlankAttrs(res) {
				let content;

				if (type(res) === 'object') {
					content = {};
					map(keys(res), (k) => {
						if (type(res[k]) in ['array', 'object'])
							content[k] = removeBlankAttrs(res[k]);
						else if (res[k] !== null && res[k] !== '')
							content[k] = res[k];
					});
				} else if (type(res) === 'array') {
					content = [];
					map(res, (k) => {
						if (type(k) in ['array', 'object'])
							push(content, removeBlankAttrs(k));
						else if (k !== null && k !== '')
							push(content, k);
					});
				} else
					return res;

				return content;
			}

			const parse_port = (strport) => {
				if (type(strport) !== 'array' || length(strport) === 0)
					return null;

				let ports = [];
				for (let i = 0; i < length(strport); i++)
					push(ports, int(strport[i]));

				return ports;
			};

			const generate_endpoint = (node_cfg) => {
				if (type(node_cfg) !== 'object' || length(node_cfg) === 0)
					return null;

				return {
					type: node_cfg.type,
					tag: 'cfg-' + node_cfg['.name'] + '-out',
					address: node_cfg.wireguard_local_address,
					mtu: strToInt(node_cfg.wireguard_mtu),
					private_key: node_cfg.wireguard_private_key,
					peers: (node_cfg.type === 'wireguard') ? [
						{
							address: node_cfg.address,
							port: strToInt(node_cfg.port),
							allowed_ips: [
								'0.0.0.0/0',
								'::/0'
							],
							persistent_keepalive_interval: strToInt(node_cfg.wireguard_persistent_keepalive_interval),
							public_key: node_cfg.wireguard_peer_public_key,
							pre_shared_key: node_cfg.wireguard_pre_shared_key,
							reserved: parse_port(node_cfg.wireguard_reserved)
						}
					] : null,
					system: (node_cfg.type === 'wireguard') ? false : null,
					tcp_fast_open: strToBool(node_cfg.tcp_fast_open),
					tcp_multi_path: strToBool(node_cfg.tcp_multi_path),
					udp_fragment: strToBool(node_cfg.udp_fragment)
				};
			};

			const generate_outbound = (node_cfg) => {
				if (type(node_cfg) !== 'object' || length(node_cfg) === 0)
					return null;

				return {
					type: node_cfg.type,
					tag: 'cfg-' + node_cfg['.name'] + '-out',

					server: (node_cfg.type !== 'direct') ? node_cfg.address : null,
					server_port: (node_cfg.type !== 'direct') ? strToInt(node_cfg.port) : null,
					server_ports: node_cfg.hysteria_hopping_port,

					username: (node_cfg.type !== 'ssh') ? node_cfg.username : null,
					user: (node_cfg.type === 'ssh') ? node_cfg.username : null,
					password: node_cfg.password,

					idle_session_check_interval: strToTime(node_cfg.anytls_idle_session_check_interval),
					idle_session_timeout: strToTime(node_cfg.anytls_idle_session_timeout),
					min_idle_session: strToInt(node_cfg.anytls_min_idle_session),
					hop_interval: strToTime(node_cfg.hysteria_hop_interval),
					up_mbps: strToInt(node_cfg.hysteria_up_mbps),
					down_mbps: strToInt(node_cfg.hysteria_down_mbps),
					obfs: node_cfg.hysteria_obfs_type ? {
						type: node_cfg.hysteria_obfs_type,
						password: node_cfg.hysteria_obfs_password
					} : node_cfg.hysteria_obfs_password,
					auth: (node_cfg.hysteria_auth_type === 'base64') ? node_cfg.hysteria_auth_payload : null,
					auth_str: (node_cfg.hysteria_auth_type === 'string') ? node_cfg.hysteria_auth_payload : null,
					recv_window_conn: strToInt(node_cfg.hysteria_recv_window_conn),
					recv_window: strToInt(node_cfg.hysteria_revc_window),
					disable_mtu_discovery: strToBool(node_cfg.hysteria_disable_mtu_discovery),
					method: node_cfg.shadowsocks_encrypt_method,
					plugin: node_cfg.shadowsocks_plugin,
					plugin_opts: node_cfg.shadowsocks_plugin_opts,
					version: (node_cfg.type === 'shadowtls') ? strToInt(node_cfg.shadowtls_version) : ((node_cfg.type === 'socks') ? node_cfg.socks_version : null),
					client_version: node_cfg.ssh_client_version,
					host_key: node_cfg.ssh_host_key,
					host_key_algorithms: node_cfg.ssh_host_key_algo,
					private_key: node_cfg.ssh_priv_key,
					private_key_passphrase: node_cfg.ssh_priv_key_pp,
					uuid: node_cfg.uuid,
					congestion_control: node_cfg.tuic_congestion_control,
					udp_relay_mode: node_cfg.tuic_udp_relay_mode,
					udp_over_stream: strToBool(node_cfg.tuic_udp_over_stream),
					zero_rtt_handshake: strToBool(node_cfg.tuic_enable_zero_rtt),
					heartbeat: strToTime(node_cfg.tuic_heartbeat),
					flow: node_cfg.vless_flow,
					alter_id: strToInt(node_cfg.vmess_alterid),
					security: node_cfg.vmess_encrypt,
					global_padding: strToBool(node_cfg.vmess_global_padding),
					authenticated_length: strToBool(node_cfg.vmess_authenticated_length),
					packet_encoding: node_cfg.packet_encoding,

					multiplex: (node_cfg.multiplex === '1') ? {
						enabled: true,
						protocol: node_cfg.multiplex_protocol,
						max_connections: strToInt(node_cfg.multiplex_max_connections),
						min_streams: strToInt(node_cfg.multiplex_min_streams),
						max_streams: strToInt(node_cfg.multiplex_max_streams),
						padding: strToBool(node_cfg.multiplex_padding),
						brutal: (node_cfg.multiplex_brutal === '1') ? {
							enabled: true,
							up_mbps: strToInt(node_cfg.multiplex_brutal_up),
							down_mbps: strToInt(node_cfg.multiplex_brutal_down)
						} : null
					} : null,
					tls: (node_cfg.tls === '1') ? {
						enabled: true,
						server_name: node_cfg.tls_sni,
						insecure: strToBool(node_cfg.tls_insecure),
						alpn: node_cfg.tls_alpn,
						min_version: node_cfg.tls_min_version,
						max_version: node_cfg.tls_max_version,
						cipher_suites: node_cfg.tls_cipher_suites,
						certificate_path: node_cfg.tls_cert_path,
						ech: (node_cfg.tls_ech === '1') ? {
							enabled: true,
							config: node_cfg.tls_ech_config,
							config_path: node_cfg.tls_ech_config_path
						} : null,
						utls: node_cfg.tls_utls ? {
							enabled: true,
							fingerprint: node_cfg.tls_utls
						} : null,
						reality: (node_cfg.tls_reality === '1') ? {
							enabled: true,
							public_key: node_cfg.tls_reality_public_key,
							short_id: node_cfg.tls_reality_short_id
						} : null
					} : null,
					transport: node_cfg.transport ? {
						type: node_cfg.transport,
						host: node_cfg.http_host || node_cfg.httpupgrade_host,
						path: node_cfg.http_path || node_cfg.ws_path,
						headers: node_cfg.ws_host ? {
							Host: node_cfg.ws_host
						} : null,
						method: node_cfg.http_method,
						max_early_data: strToInt(node_cfg.websocket_early_data),
						early_data_header_name: node_cfg.websocket_early_data_header,
						service_name: node_cfg.grpc_servicename,
						idle_timeout: node_cfg.http_idle_timeout,
						ping_timeout: node_cfg.http_ping_timeout,
						permit_without_stream: strToBool(node_cfg.grpc_permit_without_stream)
					} : null,
					udp_over_tcp: (node_cfg.udp_over_tcp === '1') ? {
						enabled: true,
						version: strToInt(node_cfg.udp_over_tcp_version)
					} : null,
					tcp_fast_open: strToBool(node_cfg.tcp_fast_open),
					tcp_multi_path: strToBool(node_cfg.tcp_multi_path),
					udp_fragment: strToBool(node_cfg.udp_fragment)
				};
			};

			const isControllerPortBusy = (port) => {
				const hex_port = sprintf('%04X', int(port));
				const tcp_v4 = readfile('/proc/net/tcp') || '';
				const tcp_v6 = readfile('/proc/net/tcp6') || '';

				for (let line in split(tcp_v4 + '\n' + tcp_v6, /\n/)) {
					const fields = split(trim(line), /[ \t]+/);
					if (length(fields) < 4)
						continue;

					const local_addr = split(fields[1], ':');
					const state = fields[3];
					if (length(local_addr) !== 2)
						continue;

					if (local_addr[1] === hex_port && state === '0A')
						return true;
				}

				return false;
			};

			const pickControllerPort = (seed) => {
				const min_port = 19090;
				const span = 100;
				let hash_seed = 0;

				for (let i = 0; i < length(seed); i++)
					hash_seed += ord(seed, i);

				const start = hash_seed % span;
				for (let i = 0; i < span; i++) {
					const candidate = min_port + ((start + i) % span);
					if (candidate === 9090)
						continue;
					if (!isControllerPortBusy(candidate))
						return candidate;
				}

				return null;
			};

			const listRuntimePidsByConfig = (config_path) => {
				if (!config_path)
					return [];

				const scan_cmd = sprintf(
					'/bin/sh -c %s -- %s',
					shellquote('cfg="$1"; for proc in /proc/[0-9]*; do [ -d "$proc" ] || continue; pid="${proc#/proc/}"; [ -r "$proc/cmdline" ] || continue; found_cfg=0; has_sig=0; p1=""; p2=""; set -f; for arg in $(tr "\\000" "\\n" <"$proc/cmdline" 2>/dev/null); do [ "$arg" = "$cfg" ] && found_cfg=1; [ "${p2##*/}" = "sing-box" ] && [ "$p1" = "run" ] && [ "$arg" = "--config" ] && has_sig=1; p2="$p1"; p1="$arg"; done; set +f; [ "$has_sig" -eq 1 ] && [ "$found_cfg" -eq 1 ] && printf "%s\\n" "$pid"; done'),
					shellquote(config_path)
				);

				const fd = popen(scan_cmd);
				if (!fd)
					return [];

				let pids = [];
				let line;
				for (line = fd.read('line'); line !== null && line !== ''; line = fd.read('line')) {
					const pid = trim(line);
					if (match(pid, /^[0-9]+$/) && index(pids, pid) === -1)
						push(pids, pid);
				}
				fd.close();

				return pids;
			};

			const isRuntimeProcess = (pid, config_path) => {
				if (!pid || !match(pid, /^[0-9]+$/) || !config_path)
					return false;

				if (system(`/bin/kill -0 ${shellquote(pid)} >/dev/null 2>&1`) !== 0)
					return false;

				return (index(listRuntimePidsByConfig(config_path), pid) !== -1);
			};

			const findRuntimePidByConfig = (config_path) => {
				const pids = listRuntimePidsByConfig(config_path);
				for (let i = 0; i < length(pids); i++) {
					const pid = pids[i];
					if (system(`/bin/kill -0 ${shellquote(pid)} >/dev/null 2>&1`) === 0)
						return pid;
				}

				return null;
			};

			const resolveRuntimePid = (runtime_meta) => {
				if (!runtime_meta?.config_path)
					return null;

				const pid_file = trim(readfile(runtime_meta.pid_path) || '');
				if (isRuntimeProcess(pid_file, runtime_meta.config_path))
					return pid_file;

				const discovered = findRuntimePidByConfig(runtime_meta.config_path);
				if (discovered)
					writefile(runtime_meta.pid_path, discovered + '\n');

				return discovered;
			};

			const cleanupProbeRuntime = (runtime_meta) => {
				if (!runtime_meta)
					return;

				const terminateRuntimePid = (pid) => {
					if (!pid)
						return;

					system(`/bin/kill ${shellquote(pid)} >/dev/null 2>&1`);
					system('/bin/sleep 1');
					if (system(`/bin/kill -0 ${shellquote(pid)} >/dev/null 2>&1`) === 0)
						system(`/bin/kill -9 ${shellquote(pid)} >/dev/null 2>&1`);
				};

				let pid = resolveRuntimePid(runtime_meta);
				while (pid) {
					terminateRuntimePid(pid);
					system(`/bin/rm -f ${shellquote(runtime_meta.pid_path)}`);
					pid = findRuntimePidByConfig(runtime_meta.config_path);
				}

				system(`/bin/rm -rf ${shellquote(runtime_meta.session_dir)}`);
			};

			const waitControllerReady = (runtime_meta, timeout_ms) => {
				try {
					let retries = int((timeout_ms + 999) / 1000);
					if (!retries || retries < 1)
						retries = 1;

					for (let i = 0; i < retries; i++) {
						resolveRuntimePid(runtime_meta);

						const probe_cmd = httpCommand(runtime_meta.controller_url + '/version', 5, null, false);
						const probe_fd = probe_cmd ? popen(probe_cmd) : null;
						if (probe_fd) {
							let payload = '', line;
							while (true) {
								line = probe_fd.read('line');
								if (line === null || line === '')
									break;
								payload += line;
							}
							probe_fd.close();
							if (trim(payload))
								return true;
						}

						if (i + 1 < retries)
							system('/bin/sleep 1');
					}

					return false;
				} catch (e) {
					return false;
				}
			};

			const buildProbeRuntime = (node_name, node_cfg) => {
				const runtime_root = RUN_DIR + '/latency-test';
				const session_id = sprintf('%s-%d-%d', node_name, time(), int(readfile('/proc/uptime') || '0'));
				const session_dir = `${runtime_root}/${session_id}`;
				const config_path = `${session_dir}/sing-box.json`;
				const log_path = `${session_dir}/sing-box.log`;
				const cache_path = `${session_dir}/cache.db`;
				const pid_path = `${session_dir}/sing-box.pid`;

				const controller_port = pickControllerPort(node_name || 'real-proxy');
				if (!controller_port)
					return { error: 'no available temporary controller port' };

				const selected_tag = 'probe-out';
				const config = {
					log: {
						disabled: false,
						level: 'warn',
						output: log_path,
						timestamp: true
					},
					outbounds: [
						{
							type: 'direct',
							tag: 'direct-out'
						},
						{
							type: 'block',
							tag: 'block-out'
						}
					],
					endpoints: [],
					route: {
						final: selected_tag,
						auto_detect_interface: true
					},
					experimental: {
						clash_api: {
							external_controller: `127.0.0.1:${controller_port}`
						},
						cache_file: {
							enabled: true,
							path: cache_path
						}
					}
				};

				const rendered_outbound = (node_cfg.type === 'wireguard') ? generate_endpoint(node_cfg) : generate_outbound(node_cfg);
				if (rendered_outbound && type(rendered_outbound) === 'object')
					rendered_outbound.tag = selected_tag;

				if (!rendered_outbound || type(rendered_outbound) !== 'object' || rendered_outbound.tag !== selected_tag || !rendered_outbound.type)
					return {
						error: 'failed to render temporary outbound for selected node',
						code: error_codes.rp_invalid_outbound
					};

				if (node_cfg.type === 'wireguard')
					push(config.endpoints, rendered_outbound);
				else
					push(config.outbounds, rendered_outbound);

				if (system(`/bin/mkdir -p ${shellquote(session_dir)}`) !== 0)
					return { error: 'failed to prepare temporary runtime directory' };

				if (!writefile(config_path, sprintf('%.J\n', removeBlankAttrs(config)))) {
					system(`/bin/rm -rf ${shellquote(session_dir)}`);
					return { error: 'failed to write temporary sing-box config' };
				}

				return {
					runtime_root,
					session_dir,
					config_path,
					log_path,
					cache_path,
					pid_path,
					controller_port,
					controller_url: `http://127.0.0.1:${controller_port}`
				};
			};

			const launchProbeRuntime = (runtime_meta) => {
				if (!runtime_meta)
					return false;

				const launch_cmd = sprintf(
					'/usr/bin/sing-box run --config %s >/dev/null 2>&1 & pid=$!; [ -n "$pid" ] && printf "%%s\\n" "$pid" > %s',
					shellquote(runtime_meta.config_path),
					shellquote(runtime_meta.pid_path)
				);

				if (system(`/bin/sh -c ${shellquote(launch_cmd)}`) !== 0)
					return false;

				for (let i = 0; i < 5; i++) {
					const pid = resolveRuntimePid(runtime_meta);
					if (pid)
						return true;

					system('/bin/sleep 1');
				}

				return false;
			};

			const monotonicMs = () => {
				/* /proc/uptime → "12345.67 23456.78"，只取第一个数。
				   同样避开正则（见 toCentims 注释）。 */
				const uptime = trim(readfile('/proc/uptime') || '');
				const dot = index(uptime, '.');

				if (dot < 0) {
					const sec = int(uptime);

					return (sec > 0) ? sec * 1000 : null;
				}

				const sec = int(substr(uptime, 0, dot));
				let frac = substr(uptime, dot + 1);

				while (length(frac) < 3)
					frac += '0';

				if (sec < 1)
					return null;

				return sec * 1000 + int(substr(frac, 0, 3));
			};

			const probeRealProxyDelay = (runtime_meta, node_name) => {
				const selected_tag = 'probe-out';
				const delay_endpoint = sprintf(
					'%s/proxies/%s/delay?url=%s&timeout=%d',
					runtime_meta.controller_url,
					selected_tag,
					rp_probe_url_encoded,
					rp_delay_timeout_ms
				);

				const started_ms = monotonicMs();
				const delay_cmd = httpCommand(delay_endpoint,
					int((rp_delay_timeout_ms + 999) / 1000), null, false);
				const fd = delay_cmd ? popen(delay_cmd) : null;
				if (!fd)
					return {
						state: 'timeout',
						error: {
							code: error_codes.rp_delay_timeout,
							message: 'failed to open temporary Clash API delay endpoint'
						}
					};

				let payload = '', line;
				while (true) {
					line = fd.read('line');
					if (line === null || line === '')
						break;
					payload += line;
				}
				fd.close();

				const ended_ms = monotonicMs();
				if (!trim(payload || '')) {
					if (started_ms !== null && ended_ms !== null && ended_ms - started_ms >= rp_delay_timeout_ms)
						return {
							state: 'timeout',
							error: {
								code: error_codes.rp_delay_timeout,
								message: sprintf('temporary Clash API delay request timed out after %dms', rp_delay_timeout_ms)
							}
						};

					return {
						state: 'error',
						error: {
							code: error_codes.rp_delay_failed,
							message: 'temporary Clash API delay response is empty'
						}
					};
				}

				let data = null;
				try {
					data = json(payload);
				} catch (e) {
					return {
						state: 'error',
						error: {
							code: error_codes.rp_delay_failed,
							message: 'temporary Clash API delay response is not valid JSON'
						}
					};
				}

				const delay_ms = int(data?.delay || '0');
				if (delay_ms > 0)
					return {
						state: 'success',
						latency_ms: delay_ms
					};

				const failure_msg = trim(sprintf('%s', data?.message || data?.error || '')) || 'temporary Clash API delay request failed';
				if (match(failure_msg, /timeout/i) || (started_ms !== null && ended_ms !== null && ended_ms - started_ms >= rp_delay_timeout_ms))
					return {
						state: 'timeout',
						error: {
							code: error_codes.rp_delay_timeout,
							message: failure_msg
						}
					};

				return {
					state: 'error',
					error: {
						code: error_codes.rp_delay_failed,
						message: failure_msg
					}
				};
			};

			const normalizeLatencyMode = (m) => (m === 'tcp') ? 'icmp' : m;
			const node = trim(req.args?.node || '') || null;
			const requested_mode = trim(req.args?.mode || '');
			const mode = normalizeLatencyMode(requested_mode);
			const allowed_modes = ['icmp', 'rp'];
			const allowed_configured_modes = ['icmp', 'tcp', 'rp'];
			if (!node)
				return formatResult(null, 'error', null, {
					code: error_codes.invalid_node,
					message: 'missing node section id'
				});

			if (index(allowed_modes, mode) === -1)
				return formatResult(node, 'error', null, {
					code: error_codes.invalid_mode,
					message: sprintf('invalid latency test mode: %s', mode || '(empty)')
				});

			const uci = cursor();
			uci.load('homeproxy');

			const configured_mode_raw = trim(uci.get('homeproxy', 'subscription', 'latency_test_mode') || '');
			const configured_mode = normalizeLatencyMode(configured_mode_raw);
			if (configured_mode_raw && index(allowed_configured_modes, configured_mode_raw) === -1)
				return formatResult(node, 'error', null, {
					code: error_codes.invalid_mode,
					message: sprintf('configured latency test mode is invalid: %s', configured_mode_raw || '(empty)')
				});

			if (configured_mode && configured_mode !== mode)
				return formatResult(node, 'error', null, {
					code: error_codes.mode_mismatch,
					message: sprintf('request mode %s does not match configured mode %s', mode, configured_mode)
				});

			const section = uci.get_all('homeproxy', node);
			if (!section || section['.type'] !== 'node')
				return formatResult(node, 'error', null, {
					code: error_codes.invalid_node,
					message: 'node section does not exist or is not a node section'
				});

			const address = trim(section.address || '');
			const port = int(section.port || '0');
			if (!address || port <= 0 || port > 65535)
				return formatResult(node, 'error', null, {
					code: error_codes.invalid_node,
					message: 'node address or port is invalid'
				});

			if (mode === 'rp') {
				let runtime_meta = null;
				let runtime_active = false;
				let runtime_info = {
					runtime_root: RUN_DIR + '/latency-test',
					session_dir: null,
					config_path: null,
					pid_path: null,
					controller: null,
					launched: false,
					controller_ready: false,
					cleaned_up: false
				};

				runtime_meta = buildProbeRuntime(node, section);
				if (runtime_meta?.error)
					runtime_info.cleaned_up = true;

				if (runtime_meta?.error)
					return formatResult(node, 'error', null, {
						code: runtime_meta.code || error_codes.rp_runtime_prepare_failed,
						message: runtime_meta.error
					}, {
						rp_runtime: runtime_info
					});

				runtime_info.session_dir = runtime_meta.session_dir;
				runtime_info.config_path = runtime_meta.config_path;
				runtime_info.pid_path = runtime_meta.pid_path;
				runtime_info.controller = `127.0.0.1:${runtime_meta.controller_port}`;
				runtime_active = true;

				const finalizeRealProxyResult = (state, latency_ms, err) => {
					if (runtime_active && runtime_meta) {
						cleanupProbeRuntime(runtime_meta);
						runtime_active = false;
						runtime_info.cleaned_up = true;
					}

					return formatResult(node, state, latency_ms, err, {
						rp_runtime: runtime_info
					});
				};

				try {
					if (!launchProbeRuntime(runtime_meta))
						return finalizeRealProxyResult('error', null, {
							code: error_codes.rp_runtime_launch_failed,
							message: 'failed to launch temporary sing-box runtime'
						});

					runtime_info.launched = true;

					if (!waitControllerReady(runtime_meta, rp_delay_timeout_ms))
						return finalizeRealProxyResult('timeout', null, {
							code: error_codes.rp_runtime_timeout,
							message: 'temporary sing-box runtime controller did not become ready in time'
						});

					runtime_info.controller_ready = true;
					const delay_result = probeRealProxyDelay(runtime_meta, node);
					if (delay_result.state === 'success' && delay_result.latency_ms > 0)
						return finalizeRealProxyResult('success', delay_result.latency_ms, null);

					if (delay_result.state === 'timeout')
						return finalizeRealProxyResult('timeout', null, delay_result.error || {
							code: error_codes.rp_delay_timeout,
							message: sprintf('temporary Clash API delay request timed out after %dms', rp_delay_timeout_ms)
						});

					return finalizeRealProxyResult('error', null, delay_result.error || {
						code: error_codes.rp_delay_failed,
						message: sprintf('temporary Clash API delay probe failed for %s', rp_probe_url)
					});
				} catch (e) {
					return finalizeRealProxyResult('error', null, {
						code: error_codes.backend_execution_failed,
						message: 'unexpected backend error while handling temporary rp runtime'
					});
				}
			}

			const ping = access('/bin/ping') ? '/bin/ping' : (access('/usr/bin/ping') ? '/usr/bin/ping' : null);

			const runProbe = (command, timeout_ms) => {
				const started_ms = monotonicMs();
				const probe_exit = system(command, timeout_ms);
				const ended_ms = monotonicMs();
				let latency_ms = null;
				if (started_ms !== null && ended_ms !== null && ended_ms >= started_ms)
					latency_ms = ended_ms - started_ms;
				return { probe_exit: probe_exit, latency_ms: latency_ms };
			};

			let icmp_latency_ms = null;
			let icmp_error = null;

			if (!ping) {
				icmp_error = {
					code: error_codes.icmp_probe_unavailable,
					message: 'missing ping executable for ICMP probe'
				};
			}
			else {
				const result = runProbe(
					`${ping} -c 1 -W ${probe_timeout_s} ${shellquote(address)} >/dev/null 2>/dev/null`,
					probe_system_timeout_ms
				);

				if (result.probe_exit === 0)
					icmp_latency_ms = (result.latency_ms !== null) ? result.latency_ms : 0;
				else if (result.probe_exit === -1 || (result.latency_ms !== null && result.latency_ms >= probe_timeout_ms))
					icmp_error = {
						code: error_codes.icmp_timeout,
						message: `ICMP ping timeout after ${probe_timeout_s}s`
					};
				else if (result.probe_exit === 127)
					icmp_error = {
						code: error_codes.backend_execution_failed,
						message: 'ICMP ping command execution failed'
					};
				else
					icmp_error = {
						code: error_codes.icmp_failed,
						message: `ICMP ping failed with exit code ${result.probe_exit}`
					};
			}

			if (icmp_latency_ms !== null)
				return formatResult(node, 'success', icmp_latency_ms, null, {
					icmp_latency_ms,
					icmp_error
				});

			if (icmp_error?.code === error_codes.icmp_timeout)
				return formatResult(node, 'timeout', null, {
					code: error_codes.probe_timeout,
					message: `ICMP probe timed out after ${probe_timeout_s}s`
				}, {
					icmp_latency_ms,
					icmp_error
				});

			return formatResult(node, 'error', null, icmp_error || {
				code: error_codes.probe_failed,
				message: 'ICMP probe failed'
			}, {
				icmp_latency_ms,
				icmp_error
			});
		}
	},

	log_clean: {
		args: { type: 'string' },
		call: function(req) {
			/* ruleset_download MUST be listed: it is one of the sources the
			   log view merges (added when the ruleset download log was hooked
			   up directly), so leaving it out made "Clean log" silently
			   fail for that one file — the rpcd call rejected with
			   "illegal type", the frontend swallowed it with
			   L.resolveDefault(), and the oldest, most confusing history
			   (ruleset downloads from weeks ago) could never be dropped. */
			if (!(req.args?.type in ['homeproxy', 'ruleset_download', 'sing-box-c', 'sing-box-s', 'core_download', 'panel_download']))
				return { result: false, error: 'illegal type' };

			const filestat = lstat(`${RUN_DIR}/${req.args?.type}.log`);
			if (filestat)
				writefile(`${RUN_DIR}/${req.args?.type}.log`, '');
			else {
				system(`mkdir -p ${RUN_DIR}`);
				writefile(`${RUN_DIR}/${req.args?.type}.log`, '');
			}
			return { result: true };
		}
	},

	/* 规则集本地文件状态（建议7）：路径解析与 fetch_rulesets.sh 的
	   resolve_path()/ruleset_file_name() 保持一致，魔数校验与
	   valid_ruleset() 一致（binary→"SRS"，source→"{" 或 "["）。 */
	ruleset_status: {
		call: function() {
			const uci = cursor();
			const result = {};

			uci.foreach('homeproxy', 'ruleset', (sec) => {
				const sid = sec['.name'],
				      stype = sec.type || 'remote',
				      fmt = sec.format || 'binary';

				let path;

				if (stype === 'local') {
					path = trim(sec.path || '');
				} else {
					let p = trim(sec.remote_path || '') || trim(sec.path || ''),
					    tag = sec.tag || ('cfg-' + sid + '-rule'),
					    name = replace(tag, /[^A-Za-z0-9_.-]/g, '_');

					if (!length(name))
						name = 'ruleset';

					const fname = name + ((fmt === 'source') ? '.json' : '.srs');

					if (!length(p))
						path = '/etc/homeproxy/ruleset/' + fname;
					else if (substr(p, length(p) - 1) === '/')
						path = p + fname;
					else
						path = p;
				}

				const entry = { exists: false, valid: false, size: 0, mtime: 0, unavailable: false };

				if (length(path)) {
					const st = lstat(path);

					if (st) {
						entry.exists = true;
						entry.size = st.size || 0;

						let mt = st.mtime;
						if (type(mt) === 'object')
							mt = mt?.sec ?? 0;
						entry.mtime = mt || 0;

						const head = readfile(path, 4) || '';

						if (fmt === 'source')
							entry.valid = (substr(head, 0, 1) === '{' || substr(head, 0, 1) === '[');
						else
							entry.valid = (substr(head, 0, 3) === 'SRS');
					}

					if (!entry.exists && stype === 'remote' && access(path + '.unavailable'))
						entry.unavailable = true;
				}

				result[sid] = entry;
			});

			return result;
		}
	},

	/* 立即更新单个远程规则集（建议9）：同步执行 fetch_rulesets.sh
	   --force --only <section>，rc === 0 即成功。单条 90 秒预算。 */
	ruleset_update: {
		args: { section: 'string' },
		call: function(req) {
			const section = req.args?.section || '';

			if (!match(section, /^[A-Za-z0-9_]+$/))
				return { result: false, error: 'illegal section' };

			const uci = cursor();
			let stype = null;

			uci.foreach('homeproxy', 'ruleset', (sec) => {
				if (sec['.name'] === section)
					stype = sec.type || 'remote';
			});

			if (stype === null)
				return { result: false, error: 'no such section' };

			if (stype !== 'remote')
				return { result: false, error: 'not a remote rule set' };

			const rc = system(`/bin/sh ${shellquote(HP_DIR + '/scripts/fetch_rulesets.sh')} --force --only ${shellquote(section)} --quiet --budget 90`);

			return { result: rc === 0, rc: rc };
		}
	},

	/* 批量补齐所有「启用 + 远程」规则集的本地副本，后台执行、立即返回。
	   为什么需要它：预下载原本只挂在 start_service 里，而 start_service
	   只有在「服务被重启」时才会跑 —— 没配节点、没开服务端时 procd 一个
	   实例都不创建，config.change 触发器形同虚设，于是「保存并应用」之后
	   规则集一条都不下载（0.1.20 现场）。这里把「同步规则集」从「重启服务」
	   里解耦出来，前端 apply 完直接调一次，跟服务状态无关。
	   脚本自带 mkdir 锁，与 start_service 的预下载互斥，重复触发安全。 */
	ruleset_sync: {
		call: function() {
			const script = HP_DIR + '/scripts/fetch_rulesets.sh';

			if (!access(script))
				return { result: false, error: '规则集下载脚本缺失' };

			/* ⚠️ 不能用 nohup 起后台任务：iStoreOS 等精简 BusyBox 不带
			   nohup（现场 `nohup: not found`，前台 shell 得到 Done(127)），
			   而 rpcd 完全看不到这种失败 —— ubus 照样返回成功，后台进程
			   却根本不存在。表现就是「点保存并应用，日志里一行规则集都
			   没有」，且 ruleset_download.log 从未生成。
			   --detach 由脚本自己完成脱管（忽略 SIGHUP + 后台 + 重定向），
			   不依赖任何外部命令。慢镜像上 21 条要几分钟，ubus 等不起，
			   前端也只需要「已经开始了」这一个事实。

			   0.1.22 现场教训：这条路的每一步此前都是零痕迹 ——
			   --quiet 连 syslog 都不写，而 ruleset_download.log 只有脚本
			   真正跑起来才会被创建。于是「rpcd 没被调用 / 调用了但脚本
			   没能启动」在日志与文件两处都无从区分。现在 ① 去掉 --quiet，
			   让下载脚本每一步 log_msg 同时进 logread（init.d 的预下载
			   路径本来就不带 --quiet，两条路口径一致）；② 下面补一行
			   调用审计：logread 里「什么都没有」= rpcd 没收到调用，
			   「只有这一行、没有下载日志」= 收到了但脚本没能启动。 */
			const rc = system(`/bin/sh ${shellquote(script)} --detach`);

			system(`logger -t homeproxy ruleset_sync: LuCI 保存并应用触发，已后台启动规则集下载（rc=${rc}）`);

			return { result: rc === 0, rc: rc };
		}
	},

	singbox_generator: {
		args: { type: 'string', params: 'string' },
		call: function(req) {
			if (!(req.args?.type in ['ech-keypair', 'uuid', 'reality-keypair', 'vapid-keypair', 'wg-keypair']))
				return { result: false, error: 'illegal type' };

			const type = req.args?.type;
			let result = {};

			const fd = popen(`/usr/bin/sing-box generate ${type} ${shellquote(req.args?.params || '')}`);
			if (fd) {
				let ech_cfg_set = false;
				let ech_key_set = false;

				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (type === 'uuid')
						result.uuid = trim(line);
					else if (type in ['reality-keypair', 'vapid-keypair', 'wg-keypair']) {
						let priv = match(trim(line), /PrivateKey: (.*)/);
						if (priv)
							result.private_key = priv[1];
						let pub = match(trim(line), /PublicKey: (.*)/);
						if (pub)
							result.public_key = pub[1];
					} else if (type in ['ech-keypair']) {
						if (trim(line) === '-----BEGIN ECH CONFIGS-----')
							ech_cfg_set = true;
						else if (trim(line) === '-----BEGIN ECH KEYS-----')
							ech_key_set = true;

						if (ech_cfg_set)
							result.ech_cfg = result.ech_cfg ? result.ech_cfg + '\n' + trim(line) : trim(line) ;
						if (ech_key_set)
							result.ech_key = result.ech_key ? result.ech_key + '\n' + trim(line) : trim(line) ;

						if (trim(line) === '-----END ECH CONFIGS-----')
							ech_cfg_set = false;
						else if (trim(line) === '-----END ECH KEYS-----')
							ech_key_set = false;
					}
				}

				fd.close();
			}

			return { result };
		}
	},

	singbox_get_features: {
		call: function() {
			let features = {};

			const fd = popen('/usr/bin/sing-box version');
			if (fd) {
				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (match(trim(line), /^sing-box version (.*)/))
						features.version = match(trim(line), /^sing-box version (.*)/)[1];

					let tags = match(trim(line), /^Tags: (.*)/);
					if (tags)
						for (let i in split(tags[1], ','))
							features[i] = true;
				}

				fd.close();
			}

			features.hp_has_ip_full = access('/usr/libexec/ip-full');
			features.hp_has_tcp_brutal = hasKernelModule('brutal.ko');
			features.hp_has_tproxy = hasKernelModule('nft_tproxy.ko') || access('/etc/modules.d/nft-tproxy');
			features.hp_has_tun = hasKernelModule('tun.ko') || access('/etc/modules.d/30-tun');

			return features;
		}
	},

	package_get_version: {
		call: function() {
			let version = trim(readfile('/usr/share/homeproxy/version') || '');

			if (!version) {
				const status = readfile('/usr/lib/opkg/status');
				let in_package = false;

				if (status) {
					const lines = split(status, '\n');
					for (let i = 0; i < length(lines); i++) {
						let line = lines[i];
						line = trim(line);

						if (!line) {
							in_package = false;
							continue;
						}

						if (line == 'Package: luci-app-homeproxy') {
							in_package = true;
							continue;
						}

						if (in_package) {
							let matched = match(line, /^Version: (.*)/);
							if (matched) {
								version = matched[1];
								break;
							}
						}
					}
				}
			}

			if (!version) {
				const fd = popen('/usr/bin/opkg status luci-app-homeproxy 2>/dev/null');
				if (fd) {
					for (let line = fd.read('line'); length(line); line = fd.read('line')) {
						let matched = match(trim(line), /^Version: (.*)/);
						if (matched) {
							version = matched[1];
							break;
						}
					}

					fd.close();
				}
			}

			if (!version) {
				/* apk-based images (e.g. OpenWrt snapshots) do not use opkg,
				 * so parse their installed-package database as a last resort. */
				const apkdb = readfile('/lib/apk/db/installed');

				if (apkdb) {
					const lines = split(apkdb, '\n');
					let current = '';

					for (let i = 0; i < length(lines); i++) {
						const line = trim(lines[i]);
						let matched;

						if (!length(line)) {
							current = '';
							continue;
						}

						matched = match(line, /^P:(.*)$/);
						if (matched) {
							current = trim(matched[1]);
							continue;
						}

						matched = match(line, /^V:(.*)$/);
						if (matched && current == 'luci-app-homeproxy') {
							version = trim(matched[1]);
							break;
						}
					}
				}
			}

			return { version: version || '-' };
		}
	},

	resources_get_version: {
		args: { type: 'string' },
		call: function(req) {
			/* Derive the error flag from the actual read result. Do NOT use
			 * fs error() here: it reports the *last* fs error of the persistent
			 * rpcd ucode VM and is cleared on read, so a leftover error from an
			 * unrelated earlier fs operation would make the first queried row
			 * (china_ip4) falsely report "not found" even though its .ver file
			 * was read successfully. */
			const version = trim(readfile(`${HP_DIR}/resources/${req.args?.type}.ver`) || '');

			return { version: version, error: length(version) ? null : 'not found' };
		}
	},
	resources_update: {
		args: { type: 'string' },
		call: function(req) {
			if (req.args?.type) {
				const type = shellquote(req.args?.type);
				const exit_code = system(`${HP_DIR}/scripts/update_resources.sh ${type}`);
				return { status: exit_code };
			} else
				return { status: 255, error: 'illegal type' };
		}
	},

	/* Runtime reF1nd sing-box core management. The correct-arch core is fetched
	 * at runtime (see root/etc/homeproxy/scripts/update_core.sh). */
	singbox_core_status: {
		call: function() {
			const result = {
				arch: '-',
				asset_available: false,
				asset: '',
				installed_version: '-',
				refind_version: '',
				/* 目标版本（下载安装后 sing-box version 会报告的完整串，
				   形如 1.14.3-reF1nd_0.1.12），由 update_core.sh 的
				   target_version 提供；缺失时回落 refind_version。 */
				target_version: ''
			};

			const fd = popen('/usr/bin/sing-box version 2>/dev/null');
			if (fd) {
				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					const matched = match(trim(line), /^sing-box version (.*)/);
					if (matched)
						result.installed_version = matched[1];
				}
				fd.close();
			}

			const sfd = popen(`/bin/sh ${HP_DIR}/scripts/update_core.sh status 2>/dev/null`);
			if (sfd) {
				for (let line = sfd.read('line'); length(line); line = sfd.read('line')) {
					line = trim(line);
					if (!length(line))
						continue;
					const kv = split(line, '=');
					if (length(kv) < 2)
						continue;
					const key = kv[0];
					const value = substr(line, length(key) + 1);
					switch (key) {
					case 'arch':
						result.arch = value;
						break;
					case 'asset_available':
						result.asset_available = (value === '1');
						break;
					case 'asset':
						result.asset = value;
						break;
					case 'refind_version':
						result.refind_version = value;
						break;
					case 'target_version':
						result.target_version = value;
						break;
					}
				}
				sfd.close();
			}

			/* Fallback: if the helper produced no output at all (e.g. the
			 * script failed to execute or is missing), the UI would otherwise
			 * show a bare "-" and "No binary for this arch". Derive a
			 * best-effort architecture here via uname so the panel stays
			 * meaningful and the download button has a chance to work. */
			if (result.arch === '-' || !length(result.arch)) {
				const ufd = popen('uname -m 2>/dev/null');
				if (ufd) {
					let mach = '';
					for (let line = ufd.read('line'); length(line); line = ufd.read('line'))
						mach = trim(line);
					ufd.close();

					if (match(mach, /^(x86_64|amd64)$/))
						result.arch = 'x86_64';
					else if (match(mach, /^(aarch64|arm64)$/))
						result.arch = 'aarch64';
					else if (length(mach))
						result.arch = mach;

					if (result.arch === 'x86_64' || result.arch === 'aarch64') {
						result.asset_available = true;
						result.asset = (result.arch === 'x86_64')
							? 'sing-box-1.14.3-reF1nd-linux-amd64-musl.tar.gz'
							: 'sing-box-1.14.3-reF1nd-linux-arm64-musl.tar.gz';
						if (!length(result.refind_version))
							result.refind_version = '1.14.3-reF1nd';
					}
				}
			}

			/* 旧版脚本不输出 target_version（或脚本整个跑不起来）时，
			   至少回落到基础版本号，UI 不会显示成空白。 */
			if (!length(result.target_version))
				result.target_version = result.refind_version;

			return result;
		}
	},

	singbox_core_update: {
		call: function() {
			/* Already downloading: report the existing run instead of
			 * launching a second one. Two concurrent helpers would fight over
			 * the same cache directory and the same target binary. */
			if (coreUpdateRunning())
				return {
					started: false,
					running: true,
					result: false,
					log: coreDownloadLogTail(12)
				};

			/* Wipe the previous run's artefacts. A stale rc/out would
			 * otherwise be read as this run's result before the helper has
			 * written anything. The log is cleared too so the tail shown by
			 * the UI always belongs to the current attempt. */
			system(`mkdir -p ${shellquote(RUN_DIR)}`);
			system(`rm -f ${shellquote(`${RUN_DIR}/core_update.rc`)} ` +
				`${shellquote(`${RUN_DIR}/core_update.out`)} ` +
				`${shellquote(`${RUN_DIR}/core_download.log`)}`);

			try {
				writefile(`${RUN_DIR}/core_update.started`, `${time()}`);
			} catch (e) {}

			/* The wrapper re-launches itself detached (`--detach`) and exits
			 * at once, so this popen returns in milliseconds. Detaching is
			 * the wrapper's job because the available helpers differ per
			 * image: iStoreOS has no `nohup`, and calling it here failed with
			 * exit 127 before the download ever started. */
			let output = '';
			const fd = popen(`/bin/sh ${HP_DIR}/scripts/update_core_async.sh --detach 2>&1`);

			if (fd) {
				for (let line = fd.read('line'); line !== null && length(line); line = fd.read('line'))
					output += line;
				fd.close();
			}

			output = trim(output);

			/* Anything on stdout/stderr here means the detach stage itself
			 * failed (script missing, not readable, wrong permissions).
			 * Reporting "started" would make the UI poll for 15 s and then
			 * show a vague failure, so surface the real message right away. */
			if (length(output))
				return {
					started: false,
					running: false,
					result: false,
					output: output,
					log: output
				};

			/* Wait briefly for the detached worker to publish its pid file.
			 * On success this returns almost immediately; on failure the UI
			 * gets a precise message now instead of polling for 15 s and then
			 * reporting a vague timeout.
			 *
			 * The rc file counts as success too: a cached/CDN-hit download
			 * finishes in a few seconds, so the worker may already have
			 * removed its pid and written its status by the time we look.
			 *
			 * `sleep 1`, not a fractional sleep: not every BusyBox build
			 * accepts a non-integer argument, and a rejected argument would
			 * spin this loop dry in microseconds, turning the check into a
			 * guaranteed false negative. */
			let spawned = false;
			for (let i = 0; i < 3 && !spawned; i++) {
				if (coreUpdateRunning() || access(`${RUN_DIR}/core_update.rc`)) {
					spawned = true;
					break;
				}
				system('sleep 1');
			}

			if (!spawned)
				return {
					started: false,
					running: false,
					result: false,
					output: '',
					log: '后台任务启动失败：' + HP_DIR + '/scripts/update_core_async.sh 未能运行。' +
						'请在路由器 SSH 执行 `sh ' + HP_DIR + '/scripts/update_core_async.sh` 查看具体错误' +
						'（常见原因：文件缺失或没有可执行权限）。'
				};

			return {
				started: true,
				running: true,
				result: false,
				log: '已启动下载任务（34 MB 内核在慢速镜像下可能需数分钟到数十分钟，可离开本页，进度会保留）。'
			};
		}
	},

	singbox_core_progress: {
		call: function() {
			const running = coreUpdateRunning();
			let rc = null;
			let started_at = 0;

			try {
				const raw = trim(readfile(`${RUN_DIR}/core_update.rc`) || '');
				if (length(raw) && match(raw, /^[0-9]+$/))
					rc = +raw;
			} catch (e) {}

			try {
				const raw = trim(readfile(`${RUN_DIR}/core_update.started`) || '');
				if (length(raw) && match(raw, /^[0-9]+$/))
					started_at = +raw;
			} catch (e) {}

			const output = coreUpdateOutput();
			const log = coreDownloadLogTail(12);

			/* Small race window: the RPC launches the wrapper through a
			 * detached shell, so for a few hundred milliseconds the pid file
			 * does not exist yet. Without a grace period the first poll would
			 * report "finished" and show a bogus failure. */
			const starting = (!running && rc === null &&
				started_at > 0 && (time() - started_at) < 15);

			const done = !running && !starting;
			const ok = done && rc === 0;

			let displayed = log;

			/* Nothing in the log but something on stdout/stderr: a fatal
			 * shell error, a missing interpreter or a permission problem
			 * happened before the helper logged its start marker. */
			if (!length(displayed) && length(output))
				displayed = output;

			if (done && !ok && !length(displayed))
				displayed = (rc === null) ?
					'后台任务未能启动：请确认 ' + HP_DIR + '/scripts/update_core_async.sh 存在且可执行，' +
						'并在路由器 SSH 执行 `sh ' + HP_DIR + '/scripts/update_core_async.sh` 查看具体错误。' :
					'脚本没有产生任何输出或日志：请在路由器 SSH 执行 ' +
						'`sh -n ' + HP_DIR + '/scripts/update_core.sh` 检查语法，并确认该文件存在且可执行（chmod 755）。';

			return {
					running: running || starting,
					done: done,
					result: ok,
					rc: rc,
					output: output,
					log: displayed
				};
			}
		},

		/* DNS 服务器行内延迟测试（建议 11）：
		   每种类型都先做真实端口探测（curl），失败再回退 ICMP ping ——
		   https→地址原 URL（443/TLS 握手）、tls→853/TLS、h3→443/TLS、
		   quic→853/TLS、tcp/udp→53/TCP 建连。
		   只对 https 做探测、其余一律 ping 是错的：ICMP 不覆盖服务端口，
		   禁 ping 的网络还会把可用服务器误判成失败。详细口径见需求书十一.8。 */
		dns_server_test: {
			args: { section: 'string' },
			call: function(req) {
				const section = req.args?.section || '';

				/* stage 只用于拼「卡在哪一步」的中文提示，全部取中文名：
				   界面上不允许再出现英文内部错误串。 */
				let stage = '读取参数';

				/* 诊断日志：就地定义，不依赖模块级函数。失败原因进 syslog
				   （logger -t homeproxy-dns），成功不记；日志本身绝不能把
				   测试搞挂。现场排查：logread -e homeproxy-dns */
				const trace = (msg) => {
					try {
						system(`logger -t homeproxy-dns ${shellquote(msg)} 2>/dev/null`);
					}
					catch (e) {}
				};

				/* 十进制小数字符串 → { int: 整数部分, frac: 小数部分 }，非法返回 null。
				   ⚠️ 这里刻意【不用正则】。踩过的坑：写成
				   /^([0-9]+)(\.([0-9]+))?$/ 在 rpcd 的 ucode 里会抛
				   “Repetition not preceded by valid expression”（regcomp 对 `?`
				   量词的报错），整条 DNS 测试直接失败，且报错是一串英文。
				   match() 底层是 C 的 regcomp/regexec，不是 JS 引擎，非捕获组
				   「?:」这种写法也不可靠；数字校验用 substr + index 逐字符判断，
				   结果确定、与正则方言无关。 */
				const isDigits = (text) => {
					const n = length(text);

					if (n < 1)
						return false;

					for (let i = 0; i < n; i++)
						if (index('0123456789', substr(text, i, 1)) < 0)
							return false;

					return true;
				};

				const parseDecimal = (value) => {
					const text = trim(`${value}`);
					const dot = index(text, '.');

					if (dot < 0) {
						if (!isDigits(text))
							return null;

						return { whole: text, frac: '' };
					}

					const intPart = substr(text, 0, dot),
					      fracPart = substr(text, dot + 1);

					/* 小数点只能有一个，两侧都得是非空数字串 */
					if (index(fracPart, '.') >= 0 || !isDigits(intPart) || !isDigits(fracPart))
						return null;

					return { whole: intPart, frac: fracPart };
				};

				/* 秒 → 毫秒：curl 的 %{time_xxx} 形如 "0.050306" → 50（截断到毫秒）。 */
				const toMs = (value) => {
					const parsed = parseDecimal(value);

					if (!parsed)
						return null;

					let frac = parsed.frac;

					while (length(frac) < 3)
						frac += '0';

					return int(parsed.whole) * 1000 + int(substr(frac, 0, 3));
				};

				/* curl 的 stderr 原样是英文（Connection refused / Could not
				   resolve host ...）。界面只显示中文归类，英文原文留在 detail
				   字段里当 tooltip，既有可读性也不丢排查信息。
				   子串判断用 index()，再次避开正则。 */
				const humanizeCurl = (text) => {
					const t = `${text}`;

					if (index(t, 'refused') >= 0)
						return '连接被拒绝，端口未开放';
					/* 现场 `curl https://1.1.1.1/` 回的是
					   "Recv failure: Connection reset by peer"（rc=35）：
					   TCP 已建连（本机 redirect 接管后放行），TLS 阶段被
					   对端/中间设备用 RST 掐断。归到「被阻断」而不是模糊的
					   「连接探测失败」，用户才知道该换端点而不是查端口。 */
					if (index(t, 'reset') >= 0)
						return '连接被重置，可能被中间设备阻断';
					if (index(t, 'timed out') >= 0 || index(t, 'Timeout') >= 0)
						return '连接超时，可能被防火墙拦截';
					if (index(t, 'resolve') >= 0)
						return '域名解析失败';
					if (index(t, 'SSL') >= 0 || index(t, 'certificate') >= 0)
						return 'TLS 握手失败';
					if (index(t, 'unreachable') >= 0 || index(t, 'route to host') >= 0)
						return '网络不可达';
					if (index(t, 'Empty reply') >= 0)
						return '服务器无应答';

					return '连接探测失败';
				};

				/* "22.809"(毫秒) → 23：四舍五入到整毫秒 */
				const toRoundedMs = (value) => {
					const parsed = parseDecimal(value);

					if (!parsed)
						return null;

					let ms = int(parsed.whole);

					if (length(parsed.frac) && int(substr(parsed.frac, 0, 1)) >= 5)
						ms++;

					return ms;
				};

				/* 统一兜底：ucode 的运行时异常会被 rpcd 折叠成
				   Command failed: Unknown error，前端和 syslog 都拿不到任何线索。
				   这里把整段包起来，并把「卡在哪一步」一并带回去 —— 下次再出问题
				   不用整轮排查，看那行字就知道。
				   整段逻辑保持就地内联（不抽成模块级函数），避免跨作用域调用带来的
				   任何不确定性。 */
				try {
					stage = '校验参数';

					if (!match(section, /^[A-Za-z0-9_]+$/))
						return { result: false, error: '服务器标识不合法，请刷新页面后重试' };

					stage = '读取配置';

					const uci = cursor();
					let type = null,
					    server = null;

					uci.foreach('homeproxy', 'dns_server', (sec) => {
						if (sec['.name'] === section) {
							type = sec.type || 'udp';
							server = sec.server || '';
						}
					});

					if (!server)
						return { result: false, error: '配置里找不到这台服务器，或地址为空' };

					/* 从带协议头的地址里提取主机名（scheme 允许数字，如 h3://） */
					stage = '解析地址';

					let host = server;
					const m = match(server, /^[a-z][a-z0-9+.-]*:\/\/(.+)$/i);

					if (m)
						host = m[1];

					/* 去掉端口、路径、IPv6 方括号。三类要分开处理：
					   一、[2606:4700::1111]:53 → 取方括号内；
					   二、裸 IPv6 2606:4700::1111 → 整串就是主机，不能按 ':' 切，
					       否则会截成 "2606"，ping 必然失败（前端校验允许裸 IPv6）；
					   三、主机名 / IPv4，可能带 :端口 或 /路径。 */
					const bracketed = match(host, /^\[([^\]]+)\]/);

					if (bracketed) {
						host = bracketed[1];
					}
					else if (!match(host, /^[0-9a-fA-F:.]+$/) || split(host, ':')[2] == null) {
						const trimmed_host = match(host, /^([^:\/]+)/);

						if (trimmed_host)
							host = trimmed_host[1];
					}

					if (!host)
						return { result: false, error: '无法从地址中解析出主机名' };

					/* 可执行文件不写死单一绝对路径：不同固件/发行版把 curl 放在
					   /usr/bin、/bin 或 /usr/sbin，写死一个会让 HTTPS 全部落到 ping
					   分支，表现成「延迟测试全失败」。按顺序取第一个可执行的即可。
					   用下标循环而不是 for-in：ucode 的 for-in 语义与 JS 不同。 */
					stage = '查找命令';

					const findExec = (paths) => {
						for (let i = 0; i < length(paths); i++)
							if (access(paths[i]))
								return paths[i];

						return null;
					};

					const curl = findExec([ '/usr/bin/curl', '/bin/curl', '/usr/sbin/curl' ]),
					      ping = findExec([ '/bin/ping', '/usr/bin/ping', '/sbin/ping' ]),
					      ping6 = findExec([ '/bin/ping6', '/usr/bin/ping6', '/sbin/ping6' ]);

					/* 每种 DNS 类型的真实探测目标（为什么这么选见需求书十一.8）：
					   - https(DoH)：用地址里的完整 URL 做 TLS 握手（443，路径保留）
					   - tls(DoT)  ：853/TCP + TLS 握手
					   - h3(DoH3)  ：443/TCP + TLS 握手
					   - quic(DoQ) ：853/TCP + TLS 握手
					   - tcp / udp ：53/TCP 建连
					   探测失败一律回退 ICMP ping，两条都失败才判「失败」。 */
					let probe = null;

					if (type === 'https')
						probe = { scheme: 'https', port: null };
					else if (type === 'tls')
						probe = { scheme: 'https', port: 853 };
					else if (type === 'h3')
						probe = { scheme: 'https', port: 443 };
					else if (type === 'quic')
						probe = { scheme: 'https', port: 853 };
					else if (type === 'tcp' || type === 'udp')
						probe = { scheme: 'http', port: 53 };

					let probe_error = null;

					if (curl && probe) {
						stage = '建立连接';

						let url;

						if (probe.port == null) {
							url = server;

							if (!match(url, /^[a-z][a-z0-9+.-]*:\/\//i))
								url = 'https://' + url;
						}
						else {
							/* IPv6 字面量要加方括号，否则 host:853 会被解析成非法 URL */
							const ipv6 = (index(host, ':') >= 0);

							url = `${probe.scheme}://${ipv6 ? '[' + host + ']' : host}:${probe.port}/`;
						}

						/* stderr 单独收集：失败时把 curl 的原始报错带回前端做 tooltip。
						   -w 结尾补 \n：fs.proc 的 read('line') 在数据没有换行时会一直
						   读到 EOF 才返回，补上换行能让计时串立刻返回。
						   ⚠️ 必须是 -sS 而不是 -s：单独的 -s 连报错一起吞掉，
						   stderr 变成空文件，日志里只剩一句「curl probe failed」，
						   现场完全无法判断是 TLS 握手失败、端口不通还是无 SNI ——
						   这正是 0.1.21 现场三个 DoH 端点全部回退 ICMP 却查不出
						   原因的直接原因。-sS = 静默进度条 + 保留错误信息。
						   -k 是必需的：DoH/DoT 地址经常直接填 IP，证书签给域名，
						   SNI/校验都对不上，不加 -k 会直接以「证书校验失败」退出，
						   一个时间都拿不到 —— 这里只量延迟，不承担证书校验职责。 */
						const maxtime = (probe.port == null) ? 6 : 3;
						const errfile = `/tmp/.hp_dns_curl_${section}`,
						      fd = popen(`${curl} -k --connect-timeout 3 --max-time ${maxtime} -sS -o /dev/null -w "%{time_connect} %{time_appconnect} %{time_total}\\n" ${shellquote(url)} 2> ${shellquote(errfile)}`);

						let line = '';

						if (fd) {
							line = trim(fd.read('line') || '');
							fd.close();
						}
						else {
							trace(`test ${section}: failed to spawn ${curl}`);
						}

						const details = trim(readfile(errfile) || '');
						unlink(errfile);

						stage = '解析耗时';

						const parts = split(line, ' ');
						const time_connect = parts[0] ? toMs(parts[0]) : null,
						      time_appconnect = parts[1] ? toMs(parts[1]) : null;

						/* 握手耗时 = time_appconnect（含 TLS），否则退回 time_connect
						   （仅 TCP）。变量名避开外层的 latency_ms，不做同名遮蔽。 */
						let hs_ms = (time_appconnect !== null && time_appconnect > 0)
							? time_appconnect
							: ((time_connect !== null && time_connect > 0) ? time_connect : null);

						/* 亚毫秒握手截断为 0：钳到 1ms，避免误判失败 */
						if (hs_ms !== null && hs_ms < 1)
							hs_ms = 1;

						if (hs_ms !== null && hs_ms > 0)
							return {
								result: true,
								latency_ms: hs_ms,
								kind: (probe.scheme === 'https') ? 'tls' : 'tcp',
								port: probe.port || null
							};

						/* 测不出来（端口不通 / 被阻断 / 域名解析失败）：记下原始报错，
						   继续往下走 ping 兜底，而不是直接判失败。 */
						probe_error = details ? split(details, '\n')[0] : 'curl probe failed';
						trace(`test ${section}: curl ${url} -> ${probe_error}`);
					}

					/* ping 测往返：用 ping 自己打印的 round-trip 平均 RTT，而非包裹
					   整个进程的墙钟时间——后者含 fork/exec 与域名解析开销，低端
					   路由上会把 8ms 虚报成 40ms+。 */
					stage = '连通性探测';

					if (!ping) {
						const reason = probe_error
							? `${humanizeCurl(probe_error)}，且系统里没有 ping 命令`
							: '系统里没有 ping 命令，无法继续测试';

						trace(`test ${section}: ${reason} (${probe_error || ''})`);

						return {
							result: false,
							error: reason,
							detail: probe_error || null,
							latency_ms: null,
							kind: probe_error ? 'probe' : 'ping'
						};
					}

					/* IPv6 字面量（含冒号）走 ping6：busybox 的 ping 默认只发 IPv4，
					   裸 IPv6 会被当作主机名去做 DNS 查询，必然失败。 */
					const pingbin = (index(host, ':') >= 0 && ping6) ? ping6 : ping;

					const pingfd = popen(`${pingbin} -c 1 -W 2 ${shellquote(host)} 2>/dev/null`);
					const out = pingfd ? readProcess(pingfd) : '';

					if (!pingfd)
						trace(`test ${section}: failed to spawn ${pingbin}`);

					stage = '解析探测结果';

					let latency_ms = null;
					const rt = match(out, /round-trip min\/avg\/max = ([0-9.]+)\/([0-9.]+)\/([0-9.]+)/);

					if (rt)
						latency_ms = toRoundedMs(rt[2]);
					else {
						const t = match(out, /time[=<] *([0-9.]+) *ms/);

						if (t)
							latency_ms = toRoundedMs(t[1]);
					}

					/* 亚毫秒 RTT 四舍五入为 0：钳到 1ms，避免误判失败 */
					if (latency_ms !== null && latency_ms < 1)
						latency_ms = 1;

					if (latency_ms !== null && latency_ms > 0) {
						/* ICMP 兜底成功：必须把「端口探测为什么失败」一起带回去。
						   只回 { result:true, kind:'ping' } 的话，界面就是一个绿色
						   毫秒数 + tooltip 里的 ICMP 字样，看上去像该协议握手正常 ——
						   0.1.21 现场三个 DoH 全部回退 ICMP 却没人察觉，就是因为
						   这个原因被丢在了这里。error 是中文归类（前端只放进
						   tooltip），detail 保留 curl 英文原文，不上正文。 */
						return {
							result: true,
							latency_ms: latency_ms,
							kind: 'ping',
							probe_failed: probe_error ? true : false,
							error: probe_error
								? `${humanizeCurl(probe_error)}（端口探测未通过，此处为本机到服务器的 ICMP 往返）`
								: null,
							detail: probe_error || null
						};
					}

					/* 走到这里说明 ping 也没成功；若之前握手已失败，把 curl 的原始
					   报错一并带回，前端 tooltip 能直接看出是证书 / DNS / 连通性问题 */
					const fail_reason = probe_error
						? humanizeCurl(probe_error)
						: (pingfd ? 'ping 无响应，服务器不可达' : `无法执行 ${pingbin}`);

					trace(`test ${section}: ${pingbin} ${host} -> ${fail_reason} (${probe_error || ''})`);

					return {
						result: false,
						error: fail_reason,
						detail: probe_error || null,
						latency_ms: null,
						kind: probe_error ? 'probe' : 'ping'
					};
				}
				catch (e) {
					trace(`test ${section}: exception at ${stage}: ${e}`);

					return {
						result: false,
						error: `测试过程出错（${stage}阶段），详情见系统日志`,
						detail: `${e}`,
						latency_ms: null,
						kind: 'error'
					};
				}
			}
		}
	};

return { 'luci.homeproxy': methods };
