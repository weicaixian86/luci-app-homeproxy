+func proxyProviderInfo(server *Server, provider option.ClashProxyProviderOptions) render.M {
+	providerType := provider.Type
+	if providerType == "" {
+		providerType = "Proxy"
+	}
+	vehicleType := provider.VehicleType
+	if vehicleType == "" {
+		vehicleType = "HTTP"
+	}
+
+	proxies := make([]any, 0, len(provider.Proxies))
+	for _, proxyName := range provider.Proxies {
+		proxy, exists := lookupProxyByName(server, proxyName)
+		if !exists {
+			continue
+		}
+		proxies = append(proxies, proxyInfo(server, proxy))
+	}
+
+	info := render.M{
+		"name":        provider.Name,
+		"type":        providerType,
+		"vehicleType": vehicleType,
+		"proxies":     proxies,
+	}
+	if provider.UpdatedAt != "" {
+		info["updatedAt"] = provider.UpdatedAt
+	}
+	return info
 }
